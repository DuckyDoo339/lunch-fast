<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LunchFlow · ส่งด่วนมื้อเที่ยง</title><meta name="description" content="จัดออเดอร์ แบ่งงานไรเดอร์ และวางแผนส่งมื้อเที่ยงในหน้าจอเดียว"><link rel="stylesheet" href="/vendor/leaflet/leaflet.css"><script src="/vendor/leaflet/leaflet.js"></script><style>
:root{--orange:#ed6b35;--ink:#27343d;--muted:#819095;--line:#e9edeb;--green:#27745c}*{box-sizing:border-box}body{margin:0;background:#f6f8f7;color:var(--ink);font-family:'Tahoma',sans-serif;font-size:14px}button,input,select{font:inherit}button,a{cursor:pointer}button{border:0;border-radius:9px;padding:11px 17px;background:var(--orange);color:white;font-weight:600}button:hover{filter:brightness(.95)}button.secondary{background:white;color:var(--ink);border:1px solid #e0e6e2}button.small{padding:7px 10px;font-size:12px}.layout{display:flex;min-height:100vh}aside{width:232px;background:white;border-right:1px solid var(--line);padding:28px 18px;position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:10px;font-size:23px;font-weight:bold;letter-spacing:-1px}.brand i{font-style:normal;border-radius:12px;background:var(--orange);color:white;width:40px;height:40px;display:grid;place-items:center}.brand small{display:block;font-size:10px;font-weight:normal;color:var(--muted);letter-spacing:1px;margin-top:3px}.navlabel{font-size:10px;letter-spacing:1.5px;color:#9da9a4;margin:36px 14px 14px}nav button{display:flex;align-items:center;gap:12px;width:100%;background:none;color:#718079;text-align:left;font-weight:normal;margin-bottom:7px;padding:13px 15px}nav button.active{background:#fff0e8;color:#d95d2b;font-weight:bold}nav span{font-size:19px;width:21px;text-align:center}.sidebottom{margin-top:auto;border-top:1px solid var(--line);padding-top:20px;line-height:1.8;font-size:12px;color:var(--muted)}.sidebottom strong{color:var(--ink)}main{margin-left:232px;width:calc(100% - 232px)}header{height:78px;padding:0 36px;background:white;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.crumb{color:#8b9790;font-size:12px}.header-right{display:flex;align-items:center;gap:16px}.avatar{background:#fbe8dd;color:#c25f39;border-radius:50%;width:36px;height:36px;display:grid;place-items:center}select,input{border:1px solid #dce3df;border-radius:8px;padding:10px;background:white;color:var(--ink)}.content{padding:32px 36px;max-width:1600px;margin:auto}.heading{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:25px}h1{font-size:26px;margin:0 0 8px;letter-spacing:-.6px}h2{font-size:17px;margin:0 0 5px}h3{font-size:15px;margin:0 0 8px}p{line-height:1.8;margin:6px 0}.sub{color:var(--muted);font-size:12px}.eyebrow{font-size:10px;letter-spacing:2px;color:var(--orange);margin-bottom:9px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:24px}.card{background:white;border:1px solid var(--line);border-radius:13px;padding:22px}.stat-top{display:flex;justify-content:space-between;align-items:center;color:#77857e;font-size:12px}.stat-icon{background:#fff1e9;border-radius:10px;padding:9px;color:var(--orange);font-size:20px}.value{font-size:30px;font-weight:bold;margin:13px 0 9px;letter-spacing:-1px}.value small{font-size:12px;font-weight:normal;color:var(--muted);margin-left:6px}.badge{display:inline-flex;align-items:center;gap:5px;border-radius:6px;padding:5px 8px;font-size:10px;background:#eaf5ee;color:#368361}.badge.orange{color:#c47a2d;background:#fff3e0}.badge.red{background:#fde9e8;color:#b54747}.badge.blue{background:#e8efff;color:#4c6bad}.grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,1fr);gap:22px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.map{position:relative;min-height:345px;background:#f1f3e9;border-radius:10px;overflow:hidden}.map svg{display:block;width:100%;height:345px}.map-label{position:absolute;top:15px;left:15px;background:white;border-radius:8px;padding:9px 12px;font-size:11px;box-shadow:0 2px 10px #26352e12}.map-bottom{position:absolute;bottom:13px;left:13px;background:#ffffffed;padding:7px 10px;font-size:10px;border-radius:6px;color:#738078}.legend{display:flex;gap:15px;flex-wrap:wrap;font-size:11px;padding-top:14px;color:#758278}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px}.rider-row{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}.rider-row:last-child{border:0}.rider-avatar{width:39px;height:39px;border-radius:50%;background:#edf1f8;display:grid;place-items:center;font-weight:bold;font-size:12px}.rider-info{flex:1}.rider-info strong{font-size:12px}.progress{height:4px;background:#edf1ee;border-radius:5px;margin-top:8px}.progress span{display:block;height:100%;border-radius:5px;background:#418d6b}.banner{display:flex;align-items:center;gap:14px;padding:17px 21px;background:#ebf4ed;border:1px solid #dceade;border-radius:11px;margin:22px 0;color:#3b6d50}.banner strong{font-size:12px}.banner p{font-size:11px;margin:2px 0}.banner .symbol{font-size:24px}.banner button{margin-left:auto;white-space:nowrap;background:white;color:#366b4c;font-size:11px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;white-space:nowrap;text-align:left;font-size:12px}th{font-weight:normal;color:#8a978f;background:#f8faf8;padding:12px 14px}td{padding:15px 14px;border-bottom:1px solid var(--line)}tbody tr:last-child td{border:0}.orderid{font-weight:bold;color:#48554d}.toolbar{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap}.toolbar input{flex:1;min-width:150px}.empty{text-align:center;padding:45px;color:var(--muted)}.two{display:grid;grid-template-columns:1fr 1fr;gap:22px}.detail{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:15px 0;font-size:13px}.detail:last-child{border:0}.detail span{color:var(--muted)}.mobile-shell{max-width:640px;margin:auto}.stop{display:flex;gap:14px;align-items:flex-start;padding:18px 0;border-bottom:1px solid var(--line)}.stop-number{background:#fff0e6;border-radius:11px;min-width:35px;height:35px;display:grid;place-items:center;color:var(--orange);font-weight:bold}.stop-text{flex:1}.stop a{color:var(--orange);text-decoration:none}.rolegrid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.rolecard{padding:40px}.rolecard .big-icon{font-size:38px;margin-bottom:20px}.note{padding:14px 17px;background:#fff8ec;color:#9a793c;border-radius:8px;font-size:12px;line-height:1.8;margin-top:16px}.route-card{margin-bottom:12px}.route-card .stops{font-size:12px;color:#7e8a83;margin:12px 0;line-height:1.9}.barrow{display:flex;gap:14px;align-items:center;margin:17px 0;font-size:12px}.barrow label{width:110px}.bar{height:14px;border-radius:5px;flex:1;background:#f4f6f3}.bar div{height:100%;border-radius:5px;background:var(--orange)}footer{margin-top:24px;display:flex;justify-content:space-between;color:#99a39e;font-size:10px}dialog{border:0;border-radius:16px;padding:28px;width:440px;max-width:92vw;box-shadow:0 15px 70px #0003}dialog::backdrop{background:#19261d55}form label{display:block;margin:14px 0 6px;font-size:12px;color:#748178}form input,form select{width:100%}.actions{display:flex;justify-content:flex-end;gap:9px;margin-top:24px}.toast{position:fixed;bottom:25px;right:25px;background:#273e30;color:white;border-radius:10px;padding:15px 22px;z-index:9;box-shadow:0 8px 30px #0002}.link{color:var(--orange);text-decoration:none}.live{font-size:10px;color:#4c8660;background:#eff8f1;padding:6px 10px;border-radius:20px}.hamburger{display:none}button:focus-visible,a:focus-visible{outline:3px solid #e9ab64;outline-offset:3px}@media(min-width:1500px){.map svg{height:395px}}@media(max-width:1050px){aside{width:190px}main{margin-left:190px;width:calc(100% - 190px)}.content{padding:24px}.grid{grid-template-columns:1fr}.stats{gap:10px}.card{padding:18px}}@media(max-width:720px){aside{display:none;z-index:6;width:232px;box-shadow:20px 0 60px #0002}aside.open{display:flex}main{margin:0;width:100%}header{padding:0 16px;height:65px}.hamburger{display:inline-block;margin-right:8px;background:white;color:#334c3c;padding:6px;font-size:20px}.crumb{display:none}.content{padding:22px 16px}.heading{align-items:flex-start;flex-wrap:wrap}h1{font-size:23px}.stats{grid-template-columns:1fr 1fr;gap:12px}.value{font-size:26px}.two,.rolegrid{grid-template-columns:1fr}.header-right{gap:8px}.header-right .sub{display:none}.header-right select{max-width:130px;font-size:11px}.banner{align-items:flex-start;flex-wrap:wrap}.banner button{margin-left:38px}.rolecard{padding:25px}.map svg{height:310px}.grid{gap:16px}.section-head{gap:12px}}
/* Restaurant and rider design systems */
:root{--orange:#ef713c;--ink:#22323f;--muted:#82909a;--line:#e8edf0}body{font-family:'Tahoma',sans-serif;background:#f4f6f8;font-size:13px}button{transition:background .18s,box-shadow .18s,transform .18s;border-radius:10px;padding:12px 19px}button:hover{filter:none;transform:translateY(-1px);box-shadow:0 4px 12px #142b4312}button.secondary:hover{background:#f5f7f9}input,select{min-height:42px}aside{background:#172836;color:#cad5df;width:246px;padding:30px 18px;border:0}aside .brand{padding:0 10px;color:white;font-size:25px}aside .brand i{background:#ed713c;box-shadow:0 4px 16px #0002;border-radius:12px}aside .brand small{color:#8198ab;font-size:9px;letter-spacing:1.4px;margin-top:6px}aside .navlabel{color:#7c93a5;font-size:9px;letter-spacing:1.5px;margin:30px 16px 16px}nav button{color:#a9bbc9;padding:14px 16px;border-radius:10px;margin:5px 0;gap:13px;font-size:12px}nav button:hover{background:#223a4b;box-shadow:none}nav button.active{background:#ed713c;color:white;box-shadow:0 5px 15px #0001}nav span{display:flex;align-items:center;justify-content:center}.sidebottom{border-color:#304350;color:#8199ab;margin:24px 12px 0;padding-top:24px}.sidebottom strong{color:#e1e9ef}.sidebar-space{margin-top:auto}.workspace-card{display:flex;align-items:center;gap:10px;border:1px solid #385060;background:#213746;padding:12px;border-radius:10px;margin:30px 9px 0;font-size:11px;color:#dde7ed}.workspace-card span{font-size:9px;color:#8aa0b1;display:block;margin-top:4px}.workspace-card .icon{color:#f29a75}main{margin-left:246px;width:calc(100% - 246px)}header{height:82px;padding:0 38px;gap:14px}.crumb{font-size:11px;color:#95a3ae}.crumb #crumb{color:#405465}.header-right{gap:15px}.context-switch{display:flex;border:1px solid #e6ebef;border-radius:9px;padding:3px;background:#f7f9fb}.context-switch button{background:transparent;color:#85949e;box-shadow:none;padding:8px 12px;font-size:10px;display:flex;align-items:center;gap:6px;border-radius:7px;font-weight:normal}.context-switch button.current{background:white;color:#273e50;box-shadow:0 1px 5px #10223013;font-weight:bold}.avatar{background:#ebf0f4;color:#42586a;font-size:11px}.content{padding:32px 38px}.eyebrow{font-size:9px;color:#a3aeba;letter-spacing:1.8px;font-weight:bold;margin-bottom:10px}h1{font-size:26px;letter-spacing:-.7px;margin-bottom:9px}h2{font-size:15px;color:#314452}h3{font-size:13px}.sub{font-size:11px;color:#8b99a3;line-height:1.8}.card{border-radius:13px;border:1px solid #e7edf1;box-shadow:0 3px 10px #17324b03;padding:23px}.stats{gap:18px;margin-bottom:22px}.stat-top{font-size:11px;color:#80909d}.stat-icon{padding:10px;background:#fdf1eb;color:#ed713c;display:grid;place-items:center}.stats .card:nth-child(2) .stat-icon{background:#eff3fc;color:#6883b5}.stats .card:nth-child(3) .stat-icon{background:#f3eef9;color:#9580b2}.stats .card:nth-child(4) .stat-icon{background:#eaf6ef;color:#459575}.value{font-size:30px;margin:12px 0 8px;color:#253c4c}.stats .card:last-child .value{color:#348464}.badge{border-radius:5px;padding:5px 8px;font-size:9px}.section-head{margin-bottom:18px}.grid{gap:22px;grid-template-columns:minmax(0,1.8fr) minmax(280px,1fr)}.map{background:#f0f3ec;border:1px solid #e5ebe4;border-radius:9px}.map-label{box-shadow:0 3px 12px #18352310;border:1px solid #e6ece5;font-size:10px}.legend{gap:16px;font-size:10px}.rider-avatar{font-size:13px;border:1px solid #eef2f5}.rider-row{padding:16px 0;border-color:#edf1f4}.rider-info strong{font-size:12px}.progress{height:4px}.banner{border-radius:10px;background:#eef7f2;border-color:#deeee4;padding:17px 22px}.banner .symbol{background:#dcefe3;color:#4d9670;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;font-size:16px}.banner strong{color:#427958}.banner p{color:#84a38e}th{background:#f8fafc;color:#8b99a7;font-size:10px;padding:13px 14px;border-bottom:1px solid #e8eef3}td{font-size:11px;padding:17px 14px;border-color:#edf1f5}.tablewrap tbody tr:hover{background:#fcfdff}.orderid{color:#5b7183;font-size:10px}.live{font-size:9px}footer{color:#a7b2ba;border-top:1px solid #e6ecf0;padding-top:18px;margin-top:30px}.icon{display:inline-block;width:19px;height:19px;stroke:currentColor;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round;vertical-align:middle}.dispatch-hero{background:#233e50;border-radius:14px;color:white;display:flex;justify-content:space-between;align-items:center;overflow:hidden;margin-bottom:24px;padding:25px 30px;position:relative;gap:20px}.dispatch-hero .hero-overline{font-size:9px;color:#a6bdc9;letter-spacing:2px;margin-bottom:10px}.dispatch-hero h2{font-size:21px;color:white;margin-bottom:9px}.dispatch-hero p{color:#a9bfcd;font-size:11px;margin:0}.hero-right{display:flex;align-items:center;gap:27px;padding-right:5px;flex-shrink:0}.hero-time .label{font-size:9px;color:#94afc0;letter-spacing:1px}.hero-time strong{display:block;margin-top:8px;font-size:25px;letter-spacing:1px;font-weight:normal}.hero-time small{font-size:9px;color:#a9c0ce}.hero-line{width:45px;height:1px;background:#57778b;position:relative}.hero-line:after{content:'›';position:absolute;right:0;top:-10px;color:#92b0c2;font-size:18px}.hero-chip{color:#ffc5a9!important;background:#ffffff0d;border:1px solid #ffffff1c;padding:7px 10px;border-radius:6px;font-size:9px!important;margin-top:10px!important;width:max-content}.side-switch{display:flex;align-items:center;gap:9px;background:#2a4051;width:100%;color:#bfced8;font-size:11px;font-weight:normal;margin-top:15px;border:1px solid #3b5366}.side-switch:hover{background:#344e62}.header-brand{display:none}.rider-bottom{display:none}.start-choice{max-width:1060px;margin:30px auto}.welcome-head{text-align:center;margin:15px auto 42px;max-width:570px}.welcome-head .eyebrow{color:#ed713c}.welcome-head h1{font-size:34px;margin:15px 0}.welcome-head p{font-size:12px;color:#82939f}.rolecard{padding:36px;position:relative;overflow:hidden;transition:box-shadow .2s,transform .2s}.rolecard:hover{transform:translateY(-3px);box-shadow:0 14px 35px #142c4510}.rolecard .big-icon{width:58px;height:58px;border-radius:15px;background:#fff0e7;color:#e97a44;display:grid;place-items:center;margin:0 0 26px}.rolecard .big-icon .icon{width:29px;height:29px}.rolecard .role-tag{font-size:9px;color:#e28a62;letter-spacing:2px;margin-bottom:12px}.rolecard h2{font-size:24px;margin-bottom:15px}.role-features{margin:22px 0;border-top:1px solid #edf1f3;padding-top:18px;display:flex;flex-wrap:wrap;gap:9px}.role-features span{border-radius:6px;padding:7px 10px;background:#f7f9fa;font-size:10px;color:#7e919e}.rolecard button{width:100%;display:flex;justify-content:space-between;align-items:center}.rolecard.rider-choice .big-icon{background:#e5f4ef;color:#368d73}.rolecard.rider-choice .role-tag{color:#43957c}.rolecard.rider-choice button{background:#23856c}.choice-foot{text-align:center;margin-top:25px;color:#a0adb7;font-size:10px}.mode-welcome aside{display:none}.mode-welcome main{margin:0;width:100%}.mode-welcome .header-brand{display:flex}.mode-welcome .crumb{display:none}.mode-welcome .content{max-width:1200px}.mode-welcome header{padding:0 7%}.mode-welcome .brand{font-size:22px}.mode-welcome .brand small{color:#9daab3}.mode-welcome .hamburger{display:none}
/* Rider has its own navigation and mobile-first workspace */
body.mode-rider{--orange:#23856c;--green:#23856c;background:#edf3f1}body.mode-rider aside{display:none}body.mode-rider main{margin:0;width:100%}body.mode-rider header{height:76px;border-bottom:1px solid #dde8e3;padding:0 max(24px,calc((100vw - 1000px)/2));position:sticky;top:0;z-index:4}body.mode-rider .header-brand{display:flex}body.mode-rider .header-brand .brand{font-size:22px;color:#25473d}body.mode-rider .header-brand .brand i{background:#23856c}body.mode-rider .header-brand .brand small{font-size:8px;color:#73a08e;letter-spacing:2px}body.mode-rider .crumb,body.mode-rider .hamburger{display:none}body.mode-rider .avatar{background:#e7f3ec;color:#328269}body.mode-rider .content{max-width:1080px;padding:30px 30px 100px}body.mode-rider .mobile-shell{max-width:760px}body.mode-rider .eyebrow{color:#78a18f}body.mode-rider .heading{margin-bottom:22px}body.mode-rider h1{color:#244b3d}body.mode-rider .card{border:1px solid #dfeae4;box-shadow:0 4px 14px #254d3604}body.mode-rider .toolbar{background:white;border:1px solid #dfeae4;border-radius:11px;padding:12px;gap:8px;margin-bottom:20px}body.mode-rider .toolbar input{min-width:110px;font-size:11px}body.mode-rider .toolbar select{font-size:11px;flex:1}body.mode-rider .toolbar button{font-size:10px;padding:10px}body.mode-rider .stop-number{background:#e8f4ee;color:#248269;border-radius:50%;border:1px solid #d6eadf;width:36px;height:36px}body.mode-rider .stop{padding:23px 0}body.mode-rider .stop-text h3{color:#315647;font-size:14px}body.mode-rider .stop .secondary{color:#43816c;border-color:#d6e8df;font-size:10px}body.mode-rider .note{background:#e4efe8;color:#739481}body.mode-rider .rider-bottom{display:flex;position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,800px);height:75px;border-radius:14px 14px 0 0;z-index:5;background:#fff;border:1px solid #dce7e1;box-shadow:0 -5px 25px #244c3610;padding:10px 25px;gap:15px}body.mode-rider .rider-bottom button{background:transparent;color:#a0b3aa;flex:1;font-size:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:5px;border-radius:9px;box-shadow:none}body.mode-rider .rider-bottom button.active{background:#e9f4ee;color:#258369}body.mode-rider .rider-bottom .icon{width:22px;height:22px}.rider-greeting{display:flex;align-items:center;gap:15px}.rider-greeting .rider-avatar{background:#ffffff18;border:1px solid #ffffff25;color:#d8eddf;width:47px;height:47px;font-size:19px}.rider-jobhero{background:#215941!important;border:0!important;padding:26px!important;position:relative;overflow:hidden}.rider-jobhero:after{content:'';width:150px;height:150px;border:30px solid #ffffff07;border-radius:50%;position:absolute;right:-60px;top:-65px;pointer-events:none}.rider-jobhero h2{color:white}.rider-jobhero .value{color:white;font-size:42px;margin:23px 0 8px}.job-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px;padding-top:20px;border-top:1px solid #ffffff25;color:#a9cbb8;font-size:10px}.job-meta strong{display:block;color:#e2f1e6;font-size:14px;margin-top:8px;font-weight:normal}.rider-jobhero .badge{background:#ffffff15;color:#cee8d9;border:1px solid #ffffff20}.status-hint{display:flex;align-items:center;gap:10px;color:#759583;font-size:11px;margin:18px 0}.status-hint i{display:grid;place-items:center;width:25px;height:25px;background:#e2eee7;border-radius:50%;font-style:normal;color:#388363}.rider-map-title{display:flex;align-items:center;justify-content:space-between}.restaurant-stamp{font-size:9px;border:1px solid #e8edef;border-radius:6px;color:#96a5af;padding:7px 10px;display:flex;gap:7px;align-items:center}
@media(max-width:1100px){aside{width:216px;padding:27px 14px}main{margin-left:216px;width:calc(100% - 216px)}.content{padding:28px}.grid{grid-template-columns:1fr}.hero-right{gap:17px}.dispatch-hero{padding:24px}.hero-time strong{font-size:22px}.hero-line{width:25px}.header-right .sub{display:none}header{padding:0 28px}.brand{font-size:23px}.workspace-card{margin:25px 7px 0}.context-switch button{padding:8px 10px}}@media(max-width:720px){aside{width:246px}.mode-owner aside.open{display:flex}.mode-owner main{margin:0;width:100%}header{padding:0 16px;height:66px}.content{padding:24px 16px}.heading{gap:17px}.heading>div:last-child{display:flex;gap:7px}.heading button{font-size:10px;padding:11px 13px}.dispatch-hero{padding:22px;display:block}.dispatch-hero h2{font-size:19px}.hero-right{justify-content:space-between;margin-top:25px;padding-top:18px;border-top:1px solid #ffffff15}.hero-time strong{font-size:23px}.hero-chip{display:none}.stats{gap:12px}.stats .card{padding:17px}.stat-icon{padding:7px}.stat-top{font-size:10px}.value{font-size:26px}.card{padding:18px}.context-switch button{font-size:9px;padding:8px}.context-switch .icon{width:15px;height:15px}.header-right{gap:9px}.header-right .avatar{display:none}.header-right .restaurant-stamp{display:none}.map svg{height:305px}.banner{padding:16px}.banner strong{font-size:11px}.banner p{font-size:10px}.rolegrid{gap:17px}.rolecard{padding:27px}.welcome-head h1{font-size:28px}.welcome-head{margin:10px auto 28px}.mode-welcome header{padding:0 16px}.mode-welcome .header-brand .brand{font-size:19px}.mode-welcome .header-brand .brand i{width:32px;height:32px}.mode-welcome .header-brand .brand small{font-size:8px}.mode-rider header{height:65px!important;padding:0 16px!important}.mode-rider .header-brand .brand{font-size:18px!important}.mode-rider .brand i{width:32px;height:32px}.mode-rider .context-switch button{padding:7px;font-size:9px}.mode-rider .context-switch .icon{display:none}.mode-rider .content{padding:25px 16px 95px!important}.mode-rider .toolbar{flex-wrap:wrap}.mode-rider .toolbar select{flex-basis:100%}.mode-rider .toolbar input{flex:1}.mode-rider .rider-bottom{height:72px!important;border-radius:0!important;padding:9px 16px!important}.mode-rider .stop{gap:10px}.mode-rider .stop .secondary{max-width:94px;padding:8px}.mode-rider .detail{gap:18px}.mode-rider .detail strong{text-align:right;max-width:65%}.mode-rider .rider-jobhero{padding:23px!important}.rider-jobhero .value{font-size:38px}.sidebottom{margin-top:20px}footer{font-size:9px}.mode-welcome .content{padding-top:25px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

/* White + neon green, with semantic action and status colors */
:root{--orange:#2563eb;--ink:#19334a;--muted:#80909e;--line:#e6edf2;--green:#168348;--neon:#b5ff36}body{background:#f7faf8}button{background:#2563eb;color:#fff}button:hover{background:#1d4ed8}button.secondary{background:#fff;color:#2d5076;border-color:#dce6f0}button.secondary:hover{background:#f0f6ff}aside{background:#fff;border-right:1px solid #e2ebe5;color:#34536f}.brand i,aside .brand i{background:#b5ff36;color:#17412b;box-shadow:none}.brand,aside .brand{color:#1e3d50}aside .brand small{color:#8fa19b}.workspace-card{background:#f7fbf3;border:1px solid #e0efd2;color:#344e40}.workspace-card span{color:#8a9d8d}.workspace-card .icon{color:#497d20}aside .navlabel{color:#98a9a2}nav button{color:#527397}nav button.active{background:#eaf2ff;color:#1f5fd5;box-shadow:none;border-left:3px solid #2563eb;padding-left:13px}nav button:hover{background:#f1f6ff;color:#2563eb}.sidebottom{border-color:#e4ece7;color:#8b9e92}.sidebottom strong{color:#425f4d}.side-switch{background:#f5f9ff;color:#3566a2;border-color:#e0eafa}.side-switch:hover{background:#eaf2ff}.header-right .avatar{background:#ebf3ff;color:#3670c4}.context-switch button.current{color:#2563eb;background:white}.context-switch button:hover{background:#eef4ff}.eyebrow{color:#8faaa0}.content h1{color:#213e4b}.stats .card:first-child .stat-icon,.stats .card:nth-child(2) .stat-icon,.stats .card:nth-child(3) .stat-icon{background:#edf4ff;color:#3870ce}.stats .card:nth-child(4) .stat-icon{background:#b5ff362a;color:#578c20}.stats .card:last-child .value{color:#294b3c}.dispatch-hero{background:#fff;color:#193e2b;border:1px solid #e0ecd9;border-left:5px solid #b5ff36;box-shadow:0 4px 20px #335b2104}.dispatch-hero .hero-overline{color:#7c988b}.dispatch-hero h2{color:#214534}.dispatch-hero p{color:#86a090}.hero-time .label{color:#8aa394}.hero-time strong{color:#254635}.hero-time strong[style]{color:#2563eb!important}.hero-time small{color:#91a798}.hero-line{background:#b5df8c}.hero-line:after{color:#78a858}.hero-chip{color:#4d762a!important;background:#f2fbe7;border:1px solid #e2f1d1}.live{background:#f1fbe5;color:#5b8127}.link,.stop a{color:#2563eb}.badge{background:#eaf7ee;color:#178344}.badge.status-primary,.badge.blue{background:#eaf2ff;color:#2563eb}.badge.status-follow,.badge.orange{background:#fff7dc;color:#9d740e}.badge.status-error,.badge.red{background:#fff0f0;color:#ce3e47}.badge.status-success{background:#e9f7ee;color:#178344}.badge.status-neutral{background:#f0f3f6;color:#748592}.note{background:#fff9e6;color:#987714}.stop-number{background:#eef4ff;color:#2563eb}.banner{background:#fff;border-color:#e1ecd7;border-left:4px solid #b5ff36;color:#5f786a}.banner .symbol{background:#f0f8e7;color:#648b3c}.banner strong{color:#52783d}.banner p{color:#8a9d83}.banner button{background:#edf4ff;color:#2563eb}.rolecard .big-icon,.rolecard.rider-choice .big-icon{background:#eff8e4;color:#528329}.rolecard .role-tag,.rolecard.rider-choice .role-tag{color:#809c69}.rolecard.rider-choice button{background:#2563eb}.rolecard.rider-choice button:hover{background:#1d4ed8}.welcome-head .eyebrow{color:#73a248}.bar div{background:#2563eb}.role-features span{background:#f6faf1;color:#8b9c7c}button:focus-visible,a:focus-visible{outline-color:#8fd82a}
body.mode-rider{--orange:#2563eb;--green:#178344;background:#f5faf6}body.mode-rider header{border-color:#e0e9e2}body.mode-rider .header-brand .brand i{background:#b5ff36;color:#28521c}body.mode-rider .avatar{background:#eaf2ff;color:#2563eb}body.mode-rider .header-brand .brand{color:#2a4538}body.mode-rider .header-brand .brand small{color:#8d9d7b}body.mode-rider .eyebrow{color:#859a77}body.mode-rider .card{border-color:#e0eadf;box-shadow:0 3px 15px #35512704}body.mode-rider .rider-jobhero{background:#fff!important;border:1px solid #e0ecd9!important;border-top:4px solid #b5ff36!important;color:#254431}.rider-jobhero:after{border-color:#b5ff361b}.rider-greeting .rider-avatar{background:#f3fbe8;border-color:#e3efcd;color:#648e3e}.rider-jobhero h2{color:#2b4b38}.rider-jobhero .rider-greeting div[style]{color:#8ba37f!important}.rider-jobhero .value{color:#244233}.rider-jobhero .value small{color:#849d79!important}.job-meta{border-color:#e3ecd8;color:#9bad8c}.job-meta strong{color:#47753a}.rider-jobhero .badge{background:#edf4ff;color:#2563eb;border-color:#e3edfa}body.mode-rider .stop-number{background:#edf4ff;color:#2563eb;border-color:#dce8fa}body.mode-rider .stop .secondary{color:#356bb7;border-color:#dce8f7}body.mode-rider .rider-bottom{border-color:#e1eae1;box-shadow:0 -5px 25px #27452108}body.mode-rider .rider-bottom button{color:#8d9ead}body.mode-rider .rider-bottom button.active{background:#edf4ff;color:#2563eb;border-top:2px solid #b5ff36}body.mode-rider .rider-bottom button:hover{background:#f3f7ff}.status-hint{color:#8a9c7f}.status-hint i{background:#f1f9e7;color:#718e45}body.mode-rider .note{background:#fff8df;color:#957518}.semantic-legend{display:flex;align-items:center;flex-wrap:wrap;gap:14px;padding:11px 0 2px;font-size:9px;color:#9aa79e}.semantic-legend span{display:flex;align-items:center;gap:5px}.semantic-legend i{width:6px;height:6px;border-radius:50%;display:inline-block}.banner.attention{background:#fffcf2;border-color:#f2e5b8;border-left-color:#e8c143}.banner.attention .symbol{background:#fff3ce;color:#a38012}.banner.attention strong{color:#947110}.banner.error{background:#fff9f9;border-color:#f3dbdd;border-left-color:#e35b63}.banner.error .symbol{background:#ffe9eb;color:#cb4650}.banner.error strong{color:#b64b52}.hero-right{border-color:#e7efdd!important}@media(max-width:720px){.semantic-legend{gap:8px;font-size:8px}.dispatch-hero{border-left-width:4px}}

/* Restaurant: orange and charcoal; Rider: white and neon green */
body.mode-owner{background:#f7f7f6;--ink:#262b30;--orange:#2563eb}body.mode-owner aside{background:#191c20;color:#c2c8cf;border-color:#252a30}body.mode-owner aside .brand{color:#fff}body.mode-owner aside .brand i{background:#f78a3c;color:#181c21}body.mode-owner aside .brand small{color:#97918b}body.mode-owner .workspace-card{background:#272523;border-color:#45372d;color:#eed7c6}body.mode-owner .workspace-card span{color:#a79180}body.mode-owner .workspace-card .icon{color:#f9954d}body.mode-owner aside .navlabel{color:#847f7b}body.mode-owner nav button{color:#9babc0}body.mode-owner nav button:hover{background:#252e3a;color:#c5d8f3}body.mode-owner nav button.active{background:#22334d;color:#8fbaff;border-left-color:#3f82f7}body.mode-owner .sidebottom{border-color:#36312c;color:#9a8a7d}body.mode-owner .sidebottom strong{color:#edc5a7}body.mode-owner .side-switch{background:#242e3d;border-color:#32435d;color:#9cbee9}body.mode-owner .side-switch:hover{background:#2c3b50}body.mode-owner header{border-bottom:2px solid #f8e8db}body.mode-owner .eyebrow{color:#b09581}body.mode-owner h1{color:#262d35}body.mode-owner .dispatch-hero{background:#212428;color:#fff;border:1px solid #303236;border-left:5px solid #f58a3d;box-shadow:0 5px 20px #20160b09}body.mode-owner .dispatch-hero .hero-overline{color:#a89b90}body.mode-owner .dispatch-hero h2{color:#fff}body.mode-owner .dispatch-hero p{color:#b09f93}body.mode-owner .hero-time .label{color:#9b9087}body.mode-owner .hero-time strong{color:#fff}body.mode-owner .hero-time strong[style]{color:#ffb67d!important}body.mode-owner .hero-time small{color:#a29286}body.mode-owner .hero-line{background:#77543b}body.mode-owner .hero-line:after{color:#c39673}body.mode-owner .hero-right{border-color:#4b3a2e!important}body.mode-owner .hero-chip{color:#e8aa7a!important;background:#3b2e24;border-color:#5b402d}body.mode-owner .live{background:#fff2e7;color:#ae6b35}body.mode-owner .stats .card:first-child .stat-icon{background:#fff0e5;color:#dc813f}body.mode-owner .stats .card:nth-child(4) .stat-icon{background:#fff0e5;color:#a96d3b}body.mode-owner .banner:not(.attention):not(.error){border-left-color:#f48b41;background:#fffdfb;border-color:#f0e6dc}body.mode-owner .banner:not(.attention):not(.error) strong{color:#98714f}body.mode-owner .banner:not(.attention):not(.error) p{color:#b39a85}body.mode-owner .banner:not(.attention):not(.error) .symbol{background:#fff0e3;color:#b77b47}body.mode-owner .card{border-color:#e9e9e6}body.mode-owner .semantic-legend{color:#a5988c}body.mode-owner .restaurant-stamp{border-color:#efe6df;color:#b19c89}body.mode-owner .context-switch{background:#f7f8fb}body.mode-owner .note{background:#fff8e6;color:#95751e}.rolecard:not(.rider-choice){border-top:3px solid #f68b3e}.rolecard:not(.rider-choice) .big-icon{background:#24282d;color:#ffa65f}.rolecard:not(.rider-choice) .role-tag{color:#c18b62}.rolecard:not(.rider-choice) .role-features span{background:#fff5ec;color:#a98970}.rolecard.rider-choice{border-top:3px solid #b5ff36}.form-note{font-size:10px;padding:11px 13px;margin-top:14px;background:#f4f7fb;border-radius:8px;color:#7e90a2;line-height:1.8}.status-field select{font-size:13px}textarea{font:inherit;border:1px solid #dce3df;border-radius:8px;padding:10px;width:100%;resize:vertical;min-height:75px}input:disabled,select:disabled{background:#f4f6f8;color:#8d9aa4}.status-field label{display:flex;align-items:center;justify-content:space-between}dialog h2{color:#2b4052}.required-mark{color:#b75f50;font-size:10px}

@font-face{font-family:'Noto Sans Thai';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/noto-sans-thai-400.ttf') format('truetype')}@font-face{font-family:'Noto Sans Thai';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/noto-sans-thai-500.ttf') format('truetype')}@font-face{font-family:'Noto Sans Thai';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/noto-sans-thai-600.ttf') format('truetype')}@font-face{font-family:'Noto Sans Thai';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/noto-sans-thai-700.ttf') format('truetype')}
html{font-family:'Noto Sans Thai',sans-serif;-webkit-text-size-adjust:100%;text-size-adjust:100%}body,button,input,select,textarea,svg{font-family:'Noto Sans Thai',sans-serif}body{font-size:14px;line-height:1.7}button,input,select,textarea{line-height:1.6}button{white-space:normal;overflow-wrap:anywhere;min-height:42px;font-weight:600}p,h1,h2,h3,small,strong,span,label,td,th{overflow-wrap:anywhere}h1{font-weight:600;font-size:28px;line-height:1.55;letter-spacing:-.3px}h2{font-weight:600;font-size:17px;line-height:1.6}h3{font-weight:600;font-size:15px;line-height:1.6}p{line-height:1.9}.sub{font-size:12px;line-height:1.85}.eyebrow{font-size:10px;line-height:1.6}.brand{line-height:1.25;font-size:24px}.brand small{line-height:1.6}.icon{flex-shrink:0}.card,.grid>*,.two>*,.rolegrid>*,.stats>*,.heading>*,.section-head>*,.toolbar>*,.stop-text,.rider-info{min-width:0}.heading{align-items:flex-start;flex-wrap:wrap}.heading>div:first-child{flex:1 1 260px}.heading>div:last-child{display:flex;flex-wrap:wrap;gap:8px;align-items:center;max-width:100%}.section-head{flex-wrap:wrap;gap:12px}.toolbar{align-items:center}.toolbar input{width:0;flex:1 1 190px;min-width:140px}.toolbar label{max-width:100%;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar label input{width:auto;flex:0 1 auto;min-width:0;max-width:100%}input,select,textarea{max-width:100%;font-size:13px}aside{overflow-y:auto;overflow-x:hidden}.navlabel{line-height:1.8}nav button{font-size:13px;line-height:1.65;min-height:49px}nav span{flex-shrink:0}.sidebottom{font-size:12px}.side-switch{font-size:12px;line-height:1.7;text-align:left}.workspace-card{font-size:12px}.workspace-card span{font-size:10px}.stat-top{font-size:12px;gap:10px}.stat-icon{flex-shrink:0}.value{font-size:clamp(24px,2.5vw,32px);line-height:1.45;letter-spacing:-.5px}.value small{font-size:12px;display:inline-block}.stats .card .sub{font-size:11px}.badge{font-size:11px;line-height:1.7;max-width:100%;white-space:normal;text-align:center;padding:5px 9px}.rider-row{gap:12px;flex-wrap:wrap}.rider-avatar{flex-shrink:0}.rider-info{flex:1 1 120px}.rider-info strong{font-size:13px}.rider-row .badge{font-size:10px}.progress{margin-top:9px}.banner{flex-wrap:wrap}.banner>div{flex:1 1 250px;min-width:0}.banner .symbol{flex-shrink:0}.banner strong{font-size:13px}.banner p{font-size:12px}.banner button{font-size:12px}.tablewrap{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}table{white-space:normal;width:100%;min-width:620px;table-layout:auto}th{font-size:12px;line-height:1.6}td{font-size:13px;line-height:1.8;max-width:260px;overflow-wrap:anywhere}td .sub{font-size:11px}.orderid{font-size:12px;white-space:nowrap}td:last-child{min-width:110px}td button{margin-bottom:4px;min-height:35px}button.small{font-size:11px;line-height:1.6;padding:8px 11px}.map-label{max-width:calc(100% - 30px);font-size:11px;line-height:1.7}.map-bottom{max-width:calc(100% - 26px);font-size:10px;line-height:1.7}.legend{font-size:11px;line-height:1.8}.map svg text{font-family:'Noto Sans Thai',sans-serif}.detail{gap:16px;flex-wrap:wrap;font-size:14px;line-height:1.8}.detail span{flex:1 1 130px}.detail strong,.detail a{flex:0 1 auto;max-width:100%}.note,.form-note{font-size:12px;line-height:1.9}.route-card .stops{font-size:13px}.route-card .section-head{gap:8px}.rolecard h2{font-size:25px}.role-features span{font-size:12px}.welcome-head p{font-size:14px}.choice-foot{font-size:12px}.semantic-legend{font-size:11px;line-height:1.9}.context-switch{flex-shrink:0}.context-switch button{font-size:11px;min-height:34px;line-height:1.5;white-space:nowrap}.restaurant-stamp{font-size:11px}.crumb{font-size:12px}.header-right{min-width:0}header{min-height:78px;height:auto;padding-top:15px;padding-bottom:15px;flex-wrap:wrap}.hero-time strong{white-space:nowrap;font-size:28px;line-height:1.5}.hero-time .label,.hero-time small{font-size:11px}.dispatch-hero .hero-overline{font-size:10px}.dispatch-hero h2{font-size:23px}.dispatch-hero p{font-size:13px}.hero-chip{font-size:11px!important;max-width:100%;width:fit-content;line-height:1.7}.hero-right{min-width:0}.hero-time{min-width:0}.dispatch-hero{gap:25px}.barrow{flex-wrap:wrap;font-size:12px}.barrow label{flex:0 0 85px;max-width:100%}.bar{min-width:60px}.barrow span{white-space:nowrap}.stop{flex-wrap:wrap}.stop-text{flex:1 1 180px}.stop-number{flex-shrink:0}.stop-text .sub{font-size:12px}dialog{max-height:90vh;max-height:90svh;overflow-y:auto;width:500px;padding:28px}form label{font-size:13px;line-height:1.75}form select,form input,form textarea{font-size:14px}.status-field label{flex-wrap:wrap;gap:8px}.required-mark{font-size:11px}.actions{flex-wrap:wrap;gap:9px}.actions button{min-width:90px}.toast{max-width:calc(100vw - 32px);right:16px;overflow-wrap:anywhere;line-height:1.8;font-size:13px}footer{gap:15px;flex-wrap:wrap;font-size:11px;line-height:1.8}.mode-rider .content h1{font-size:27px}.mode-rider .toolbar{flex-wrap:wrap}.mode-rider .toolbar select{font-size:13px;min-width:160px;flex:1 1 170px}.mode-rider .toolbar input{font-size:13px;flex:1 1 150px}.mode-rider .toolbar button{font-size:12px}.mode-rider .stop-text h3{font-size:16px}.mode-rider .stop .secondary{font-size:12px}.mode-rider .rider-bottom button{font-size:12px;line-height:1.6}.rider-jobhero .rider-greeting div[style]{font-size:12px!important}.job-meta{font-size:12px}.job-meta strong{font-size:16px}.status-hint{font-size:13px}.mode-rider .header-brand .brand{font-size:23px}.mode-rider .header-brand .brand small{font-size:9px}.rider-jobhero .section-head{align-items:center}
/* Bright restaurant palette */
body.mode-owner{background:#fcfaf7}body.mode-owner aside{background:#fff;border-right:1px solid #f0e7dc;color:#526376}body.mode-owner aside .brand{color:#333e48}body.mode-owner aside .brand i{background:#fff0df;color:#e68336;border:1px solid #ffe0bf}body.mode-owner aside .brand small{color:#b0a195}body.mode-owner .workspace-card{background:#fff8ee;border-color:#f8e8d1;color:#9f744f}body.mode-owner .workspace-card span{color:#b4a18e}body.mode-owner .workspace-card .icon{color:#eb9b52}body.mode-owner aside .navlabel{color:#baac9d}body.mode-owner nav button{color:#7187a1}body.mode-owner nav button:hover{background:#f5f8ff;color:#3470d4}body.mode-owner nav button.active{background:#edf4ff;color:#2563eb;border-left-color:#2563eb}body.mode-owner .sidebottom{border-color:#f0e7dc;color:#b5a28f}body.mode-owner .sidebottom strong{color:#af805c}body.mode-owner .side-switch{background:#f2f7ff;border-color:#e1ebfb;color:#4e79bd}body.mode-owner .side-switch:hover{background:#eaf2ff}body.mode-owner header{background:#fff;border-bottom:1px solid #f2e9de}body.mode-owner .dispatch-hero{background:#fff5e8;border-color:#fae6c9;border-left-color:#f7a354;box-shadow:0 4px 20px #b7864204}body.mode-owner .dispatch-hero .hero-overline{color:#c69d76}body.mode-owner .dispatch-hero h2{color:#966f4d}body.mode-owner .dispatch-hero p{color:#b49273}body.mode-owner .hero-time .label{color:#bf9b79}body.mode-owner .hero-time strong{color:#a77247}body.mode-owner .hero-time strong[style]{color:#dd944f!important}body.mode-owner .hero-time small{color:#bc9a7d}body.mode-owner .hero-line{background:#e7c9a5}body.mode-owner .hero-line:after{color:#d5b085}body.mode-owner .hero-right{border-color:#f1ddc0!important}body.mode-owner .hero-chip{color:#b4885d!important;background:#fffdf7;border-color:#f4dfc1}body.mode-owner .card{border-color:#eee8df;box-shadow:0 3px 12px #ad805503}body.mode-owner .stats .card:first-child .stat-icon{background:#fff2e3;color:#e59a53}body.mode-owner .restaurant-stamp{background:#fffcf7;border-color:#f3e8d9;color:#ba9a7c}.rolecard:not(.rider-choice) .big-icon{background:#fff1df;color:#df954b}.rolecard:not(.rider-choice){border-top-color:#f7ac62}
@media(max-width:1100px){.dispatch-hero{flex-wrap:wrap}.hero-right{flex:1 1 280px;justify-content:space-around}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}header .restaurant-stamp{display:none}.value{font-size:29px}}@media(max-width:720px){body{font-size:14px}.content{padding:24px 16px}.heading>div:first-child{flex-basis:100%}.heading>div:last-child{max-width:100%;gap:8px}.heading button{font-size:12px;min-height:42px;padding:10px 13px}.heading h1,.mode-rider .content h1{font-size:25px}.stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.stats .card{padding:15px 12px}.stat-top{font-size:11px;gap:5px;flex-wrap:wrap}.stat-icon{padding:6px}.stats .value{font-size:24px}.stats .value small{font-size:10px}.stats .card .sub{font-size:10px}.card{padding:18px 15px}.section-head h2{font-size:16px}.banner strong{font-size:13px}.banner p{font-size:11px}.banner button{margin-left:0}.dispatch-hero{padding:21px}.dispatch-hero h2{font-size:21px}.dispatch-hero p{font-size:12px}.hero-time strong{font-size:26px}.hero-time .label,.hero-time small{font-size:10px}.context-switch button{font-size:11px;padding:8px 10px}.context-switch .icon{width:15px}.mode-rider .context-switch button{font-size:10px;padding:8px}.mode-rider .header-brand .brand{font-size:19px!important}.mode-rider .header-brand .brand small{font-size:8px}.mode-rider header{height:auto!important;min-height:65px;padding:12px 16px!important;gap:10px}.mode-rider .toolbar select{flex-basis:100%;font-size:13px}.mode-rider .toolbar input{font-size:13px;flex-basis:140px}.mode-rider .stop{gap:12px}.mode-rider .stop-text{flex:1 1 calc(100% - 50px)}.mode-rider .stop .secondary{max-width:none;margin-left:48px}.mode-rider .detail strong{text-align:left;max-width:100%}.mode-rider .detail{gap:8px}.mode-rider .rider-bottom button{font-size:11px;padding:7px;min-width:0}.rider-jobhero .value{font-size:38px}.job-meta{font-size:11px;gap:8px}.job-meta strong{font-size:14px}.rider-greeting{gap:10px;min-width:0}.rider-greeting h2{font-size:16px}.rider-greeting .rider-avatar{width:40px;height:40px;flex-shrink:0}.semantic-legend{font-size:10px;gap:10px}footer{font-size:10px}.rolecard{padding:25px}.rolecard h2{font-size:23px}.role-features span{font-size:11px}.welcome-head h1{font-size:27px}.welcome-head p{font-size:13px}.mode-welcome header{gap:12px}.mode-welcome .header-brand .brand{font-size:19px}dialog{padding:23px;max-width:calc(100vw - 28px)}dialog .two{grid-template-columns:1fr 1fr;gap:12px}.two input{min-width:0}.map-bottom{font-size:9px}.map-label{font-size:10px}.header-right{gap:6px}.mode-rider .header-brand{flex:1 1 140px}.status-field .badge{font-size:10px}}@media(max-width:380px){.stats .value{font-size:21px}.header-right .context-switch button{font-size:10px;padding:8px}.mode-rider .header-brand .brand{font-size:17px!important}.mode-rider .context-switch button{font-size:9px}.hero-time strong{font-size:24px}.heading>div:last-child button{flex:1 1 120px}.stats .card .stat-icon{padding:5px}.mode-rider .rider-jobhero{padding:20px!important}.job-meta{grid-template-columns:1fr 1fr}.job-meta>div:last-child{grid-column:1/-1}.map svg{min-height:280px}}

/* Restaurant brand: pink accents, charcoal type, white surfaces */
body.mode-owner{background:#fff7fa;--ink:#242424}body.mode-owner aside{background:#fff;border-right-color:#f4e5ed;color:#454148}body.mode-owner aside .brand{color:#242424}body.mode-owner aside .brand i{background:#fce7f3;color:#ec4899;border-color:#fbcfe8}body.mode-owner aside .brand small{color:#ad94a1}body.mode-owner .workspace-card{background:#fff3f8;border-color:#f6dce9;color:#795464}body.mode-owner .workspace-card span{color:#ad8c9c}body.mode-owner .workspace-card .icon{color:#ec4899}body.mode-owner aside .navlabel{color:#b29aa7}body.mode-owner .sidebottom{border-color:#f2e4eb;color:#af95a3}body.mode-owner .sidebottom strong{color:#85586f}body.mode-owner header{background:#fff;border-bottom-color:#f4e4ec}body.mode-owner .eyebrow{color:#b18b9f}body.mode-owner h1{color:#242424}body.mode-owner h2,body.mode-owner h3{color:#343036}body.mode-owner .dispatch-hero{background:#fff0f7;border-color:#f8dce9;border-left-color:#ec4899;box-shadow:0 4px 20px #ad3f6d04}body.mode-owner .dispatch-hero .hero-overline{color:#b58b9e}body.mode-owner .dispatch-hero h2{color:#33252f}body.mode-owner .dispatch-hero p{color:#a67f91}body.mode-owner .hero-time .label{color:#b38b9d}body.mode-owner .hero-time strong{color:#33252f}body.mode-owner .hero-time strong[style]{color:#db3b89!important}body.mode-owner .hero-time small{color:#b48da0}body.mode-owner .hero-line{background:#eebed3}body.mode-owner .hero-line:after{color:#d597b3}body.mode-owner .hero-right{border-color:#f3d4e3!important}body.mode-owner .hero-chip{color:#b25d86!important;background:#fffafd;border-color:#f4cfe1}body.mode-owner .card{background:#fff;border-color:#f0e5eb;box-shadow:0 3px 12px #a63f6d03}body.mode-owner .stats .card:first-child .stat-icon,body.mode-owner .stats .card:nth-child(4) .stat-icon{background:#fdf0f7;color:#db5b99}body.mode-owner .stats .value{color:#2f2a30}body.mode-owner .live{background:#fdf0f7;color:#b5628b}body.mode-owner .restaurant-stamp{background:#fffafd;border-color:#f3e0e9;color:#b090a0}body.mode-owner .banner:not(.attention):not(.error){background:#fffbfd;border-color:#f2e2ea;border-left-color:#ec4899}body.mode-owner .banner:not(.attention):not(.error) strong{color:#94627c}body.mode-owner .banner:not(.attention):not(.error) p{color:#b895a7}body.mode-owner .banner:not(.attention):not(.error) .symbol{background:#fcebf4;color:#bd6d94}body.mode-owner .semantic-legend{color:#aa95a0}body.mode-owner footer{border-color:#f0e3ea;color:#b19eaa}.rolecard:not(.rider-choice){border-top-color:#ec4899}.rolecard:not(.rider-choice) .big-icon{background:#fce7f3;color:#db3b89}.rolecard:not(.rider-choice) .role-tag{color:#bc7196}.rolecard:not(.rider-choice) .role-features span{background:#fff3f8;color:#a87991}

/* Orange + charcoal restaurant; semantic action colors stay blue */
body.mode-owner{background:#fcfaf7;--ink:#262d33}body.mode-owner aside{background:#202329;border-color:#30343b;color:#b7c2d0}body.mode-owner aside .brand{color:#fff}body.mode-owner aside .brand i{background:#f29145;border-color:#f29145;color:#202329}body.mode-owner aside .brand small{color:#a2a3a5}body.mode-owner .workspace-card{background:#302c28;border-color:#4b3b2e;color:#ecc7a7}body.mode-owner .workspace-card span{color:#ac9887}body.mode-owner .workspace-card .icon{color:#f3a565}body.mode-owner aside .navlabel{color:#928a81}body.mode-owner nav button{color:#a9bbd1}body.mode-owner nav button:hover{background:#2a3547;color:#d6e6ff}body.mode-owner nav button.active{background:#283c5c;color:#a0c3ff;border-left-color:#4f8cff}body.mode-owner .sidebottom{border-color:#42372d;color:#b09e8d}body.mode-owner .sidebottom strong{color:#e5bb98}body.mode-owner header{border-color:#f0e5d8}body.mode-owner .eyebrow{color:#a99581}body.mode-owner h1{color:#262d33}body.mode-owner h2,body.mode-owner h3{color:#36404b}body.mode-owner .dispatch-hero{background:#fff1e0;border-color:#f7dfbe;border-left-color:#f29448;box-shadow:0 6px 28px #b7762207}body.mode-owner .dispatch-hero .hero-overline{color:#b79571}body.mode-owner .dispatch-hero h2{color:#5e4c3e}body.mode-owner .dispatch-hero p{color:#a9947e}body.mode-owner .hero-time .label{color:#b2977b}body.mode-owner .hero-time strong{color:#654e3a}body.mode-owner .hero-time strong[style]{color:#e28b40!important}body.mode-owner .hero-time small{color:#b29579}body.mode-owner .hero-line{background:#e9c99f}body.mode-owner .hero-line:after{color:#c79866}body.mode-owner .hero-right{border-color:#eed8bb!important}body.mode-owner .hero-chip{color:#ab8050!important;background:#fffbf4;border-color:#efdabd}body.mode-owner .card{border-color:#eee6dd;box-shadow:0 4px 18px #70501f04}body.mode-owner .stats .card:first-child .stat-icon,body.mode-owner .stats .card:nth-child(4) .stat-icon{background:#fff0df;color:#df974f}body.mode-owner .live{background:#fff0df;color:#aa743b}body.mode-owner .restaurant-stamp{background:#fffaf3;border-color:#efe0cb;color:#b09779}body.mode-owner .banner:not(.attention):not(.error){background:#fffcf8;border-color:#f0e4d4;border-left-color:#ee964e}body.mode-owner .banner:not(.attention):not(.error) strong{color:#99724d}body.mode-owner .banner:not(.attention):not(.error) p{color:#b1977c}body.mode-owner .banner:not(.attention):not(.error) .symbol{background:#fff0df;color:#bb864a}body.mode-owner footer{border-color:#eee3d5;color:#ad9b88}body.mode-owner .semantic-legend{color:#a89987}.rolecard:not(.rider-choice){border-top-color:#f29448}.rolecard:not(.rider-choice) .big-icon{background:#25282d;color:#ffa65c}.rolecard:not(.rider-choice) .role-tag{color:#b58761}.rolecard:not(.rider-choice) .role-features span{background:#fff5e9;color:#a68b70}
/* Compact Rider navigation: icons and labels have independent sizes */
body.mode-rider .rider-bottom{height:70px!important;padding:8px 14px!important;gap:8px;align-items:stretch;padding-bottom:max(8px,env(safe-area-inset-bottom))!important}body.mode-rider .rider-bottom button{flex:1 1 0;width:0;min-width:0;min-height:0;margin:0;padding:5px 6px!important;gap:5px;font-size:10px!important;line-height:1.2;overflow:hidden}body.mode-rider .rider-bottom button span{font-size:10px!important;line-height:1.25!important;font-weight:500;letter-spacing:0;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}body.mode-rider .rider-bottom .icon{width:20px;height:20px;flex-shrink:0}
/* Real interactive maps */
.map-frame{position:relative}.leaflet-map.map{height:410px;min-height:310px;isolation:isolate;background:#eaf0e8;z-index:1}.leaflet-map.map svg{width:auto;height:auto;display:block}.leaflet-container{font-family:'Noto Sans Thai',sans-serif;font-size:12px}.leaflet-container .leaflet-control-attribution{font-size:9px;line-height:1.5;padding:3px 5px;max-width:100%;color:#697968}.leaflet-container a{color:#2563eb}.leaflet-control-zoom a{color:#355a7e!important}.leaflet-map .leaflet-tile{max-width:none!important;max-height:none!important}.leaflet-map .leaflet-popup-content{line-height:1.9;font-family:'Noto Sans Thai',sans-serif;margin:15px 18px;overflow-wrap:anywhere}.leaflet-map .leaflet-popup-content .sub{font-size:11px}.leaflet-container .leaflet-marker-icon.stop-pin{border:0;background:transparent}.stop-pin span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 12px #23362b30;color:#fff;font-size:11px;font-weight:600}.stop-pin.shop-pin span{width:34px;height:34px;border-radius:10px;background:#26342d;font-size:19px}.map-tools{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px;flex-wrap:wrap}.map-tools span{font-size:11px;color:#87988a}.map-tools button{padding:7px 10px;min-height:34px;font-size:11px}.map-status{padding:9px 0 0;font-size:10px;color:#8a9b8b;line-height:1.8}.map-status.attention{color:#a78723}.map-status.error{color:#c25454}.map-filter{display:flex;gap:7px;flex-wrap:wrap;padding-top:13px}.map-filter button{min-height:31px;padding:6px 10px;font-size:10px;border:1px solid #e2e9e1;background:#fff;color:#6e846f;font-weight:500;line-height:1.5}.map-filter button:hover{background:#f2f7ff;border-color:#baceed;color:#2563eb}.map-filter .dot{width:7px;height:7px;margin:0 4px 0 0}.map-frame.is-expanded{position:fixed;inset:95px 25px 35px 270px;background:white;border:1px solid #dbe6dc;border-radius:16px;padding:20px;z-index:700;box-shadow:0 20px 100px #24302635;display:flex;flex-direction:column}.map-frame.is-expanded .leaflet-map{flex:1;height:auto!important;min-height:200px}.mode-rider .map-frame.is-expanded{inset:90px 25px 90px}.map-no-service{display:grid;place-content:center;text-align:center;gap:12px;padding:35px;color:#87987d;height:100%;background:#f2f5ed}.picker-map{height:250px;margin-top:14px;border-radius:10px;border:1px solid #dde7e0}.picker-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:15px}.picker-actions .sub{font-size:11px}.picker-help{font-size:10px;color:#869b8b;padding-top:8px}.live-progress{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 23px;margin-bottom:22px;background:#fff;border:1px solid #e8eadf;border-radius:12px}.live-progress h3{font-size:13px;margin:0 0 6px}.live-progress .sub{font-size:11px}.delivery-meter{flex:1;max-width:340px;min-width:100px}.delivery-meter .progress{height:7px;background:#f0f4ee;margin:0}.delivery-meter .progress span{background:linear-gradient(90deg,#74bd88,#268852);transition:width .6s}.delivery-meter .meter-label{display:flex;justify-content:space-between;font-size:10px;color:#94a38f;margin-bottom:8px}.live-progress .secondary{font-size:11px;padding:9px 13px}.modern-motion #app{animation:workspace-enter .28s ease-out}.stats .card{transition:transform .2s,box-shadow .2s,border-color .2s;cursor:pointer;position:relative}.stats .card:hover{transform:translateY(-3px);box-shadow:0 9px 25px #3a32130b;border-color:#e7d8c4}.stats .card:after{content:'↗';position:absolute;bottom:14px;right:15px;color:#c6b9a4;font-size:12px;opacity:0;transition:opacity .2s}.stats .card:hover:after{opacity:1}.route-card{transition:box-shadow .2s,border-color .2s}.route-card:hover{border-color:#c9d9f2;box-shadow:0 6px 20px #2e477512}button{position:relative;overflow:hidden}.ripple-wave{position:absolute;pointer-events:none;border-radius:50%;background:currentColor;opacity:.13;transform:scale(0);animation:ripple .5s ease-out}.dispatch-hero{position:relative;overflow:hidden}.dispatch-hero:after{content:'';position:absolute;right:-40px;top:-70px;width:250px;height:250px;border:30px solid #efac4d09;border-radius:50%;pointer-events:none}.hero-line:before{content:'';position:absolute;width:5px;height:5px;background:#e5a663;border-radius:50%;top:-2px;animation:route-pulse 3s infinite}.mode-rider .stats .card:hover{border-color:#d4e5ca}.stats .card:focus-visible{outline:3px solid #9fbff4;outline-offset:2px}@keyframes workspace-enter{from{opacity:.4;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@keyframes ripple{to{transform:scale(2);opacity:0}}@keyframes route-pulse{0%{left:0;opacity:0}20%{opacity:1}80%{opacity:1}100%{left:100%;opacity:0}}
@media(max-width:1100px){.map-frame.is-expanded{left:230px}.live-progress{flex-wrap:wrap}.delivery-meter{max-width:none;flex:1 1 180px}}@media(max-width:720px){.leaflet-map.map{height:350px;min-height:280px}.map-frame.is-expanded,.mode-rider .map-frame.is-expanded{inset:75px 10px 85px!important;padding:14px}.map-tools span{font-size:10px}.map-filter button{font-size:10px}.live-progress{padding:17px;gap:13px}.live-progress>div:first-child{flex:1 1 150px}.live-progress .delivery-meter{flex-basis:100%;order:3}.map-status{font-size:10px}.picker-map{height:230px}.mode-rider .rider-bottom button span{font-size:9px!important}}@media(prefers-reduced-motion:reduce){.modern-motion #app,.hero-line:before,.ripple-wave{animation:none!important}.stats .card:hover{transform:none}.delivery-meter .progress span{transition:none}}

</style></head><body><div class="layout"><aside id="sidebar"><div class="brand"><i>↗</i><div>LunchFlow<small>ส่งด่วนมื้อเที่ยง</small></div></div><div class="navlabel">WORKSPACE / เจ้าของร้าน</div><nav id="nav"></nav><div class="sidebottom"><strong>มื้อเที่ยงที่ตรงเวลา</strong><br>เริ่มส่ง 11:30 · ถึงก่อน 12:30<br><span class="badge" style="margin-top:12px">● โหมดทดลอง · ไม่มี Login</span></div></aside><main><header><div><button class="hamburger" onclick="document.getElementById('sidebar').classList.toggle('open')" aria-label="เปิดเมนู">☰</button><span class="crumb">Workspace &nbsp; / &nbsp; <span id="crumb"></span></span></div><div class="header-right"><span class="sub">MSU · มหาสารคาม</span><select id="role" onchange="go(this.value==='owner'?'dashboard':'jobs')" aria-label="สลับมุมมอง"><option value="owner">เจ้าของร้าน</option><option value="rider">ไรเดอร์</option></select><div class="avatar">LF</div></div></header><div class="content" id="app"></div></main></div><dialog id="modal"></dialog><div id="toast" hidden class="toast"></div><script>
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const colors=['#ed784c','#5683c5','#53a283','#a87fb8','#d0a451','#71a6ad','#ad7785','#7380a4'];const menus=[['dashboard','◫','ภาพรวมวันนี้'],['customers','♙','ข้อมูลลูกค้า'],['orders','▤','จัดการออเดอร์'],['routes','⌁','เส้นทางและแบ่งงาน'],['reports','▥','รายงานและกำไร'],['welcome','⇄','เลือกมุมมอง'],['jobs','▣','ใบงานของฉัน'],['navigation','➤','แผนที่นำทาง'],['delivery','◉','รายละเอียดจัดส่ง']];let page='dashboard',query='',filter='all',selected=0,selectedOrder=null;
function seed(){const names=['ณัฐวุฒิ','พิมพ์ชนก','กิตติพงษ์','ศิริพร','ธนกร','อรทัย','วรพล','ชลธิชา','ปิยวัฒน์','สุภาวดี','นภัสสร','ธนภัทร','อริสา','ภูวดล','กมลชนก','ศุภชัย','จิราพร','วีรภัทร','พรนภา','นันทวัฒน์','อัญชลี','ธีรเดช','รัตนา','อนุชา'];return {customers:names.map((n,i)=>({id:i+1,name:n,phone:'080'+String(1234000+i),address:['หอพักแสนสุข ขามเรียง','หมู่บ้านท่าขอนยาง','หอพักสวนปาล์ม','หอพักใกล้ มมส.'][i%4]+' ห้อง '+(101+i),lat:16.246+Math.sin(i*2.1)*(.006+i%4*.002),lng:103.250+Math.cos(i*2.1)*(.006+i%3*.002),note:'โทรก่อนถึง · ฝากที่จุดรับอาหารได้'})),orders:names.map((_,i)=>({id:1001+i,customer:i+1,boxes:i%3+1,status:'รอจัดส่ง'})),riders:['บอส','มิกซ์','ฟ้า','ต้น','นัท','เบล','ปอนด์','เจ'].map((n,i)=>({id:i,name:n})),routes:[],history:[],settings:{delay:3,depart:'11:30'}}}
let state;try{state=JSON.parse(localStorage.getItem('lunchflow-v1'))||seed()}catch{state=seed()}function save(){localStorage.setItem('lunchflow-v1',JSON.stringify(state))}const customer=id=>state.customers.find(c=>c.id===id),money=n=>new Intl.NumberFormat('th-TH',{maximumFractionDigits:2}).format(n),activeOrders=()=>state.orders.filter(o=>o.status!=='ยกเลิก');function toast(t){$('#toast').textContent=t;$('#toast').hidden=false;setTimeout(()=>$('#toast').hidden=true,3500)}
function km(a,b){const p=Math.PI/180,x=(b.lng-a.lng)*Math.cos((a.lat+b.lat)*p/2),y=b.lat-a.lat;return Math.sqrt(x*x+y*y)*111.32}const shop={lat:16.246,lng:103.250};function routeMetrics(ids){let prev=shop,d=0;let deliveries=[];ids.forEach(id=>{let o=state.orders.find(o=>o.id===id);if(!o)return;let c=customer(o.customer);d+=km(prev,c);deliveries.push({id,d,minutes:d/30*60+deliveries.length*state.settings.delay+state.settings.delay});prev=c});return {distance:d,deliveries,time:d/30*60+ids.length*state.settings.delay}}
function time(minutes){let [h,m]=state.settings.depart.split(':').map(Number),total=h*60+m+Math.ceil(minutes);return String(Math.floor(total/60)).padStart(2,'0')+':'+String(total%60).padStart(2,'0')}function late(r){return time(routeMetrics(r.ids).time)>'12:30'}
function calculate(alt=false){let pool=activeOrders().filter(o=>!['ส่งสำเร็จ','กำลังจัดส่ง','ส่งไม่สำเร็จ'].includes(o.status));let locked=state.routes.filter(r=>r.ids.some(id=>['ส่งสำเร็จ','กำลังจัดส่ง','ส่งไม่สำเร็จ'].includes(state.orders.find(o=>o.id===id)?.status)));let lockedIds=new Set(locked.flatMap(r=>r.ids));pool=pool.filter(o=>!lockedIds.has(o.id));pool.sort((a,b)=>{let ca=customer(a.customer),cb=customer(b.customer);return Math.atan2(ca.lat-shop.lat,ca.lng-shop.lng)-Math.atan2(cb.lat-shop.lat,cb.lng-shop.lng)});if(alt&&pool.length)pool.push(pool.shift());let free=state.riders.filter(r=>!locked.some(x=>x.rider===r.id));let routes=[...locked];for(let rider of free){if(!pool.length)break;let group=pool.splice(0,3),ids=[],prev=shop;while(group.length){group.sort((a,b)=>km(prev,customer(a.customer))-km(prev,customer(b.customer)));let next=group.shift();ids.push(next.id);prev=customer(next.customer);next.status='จัดสรรไรเดอร์แล้ว'}routes.push({rider:rider.id,ids})}pool.forEach(o=>o.status='รอจัดส่ง');state.routes=routes;state.history.push({at:new Date().toISOString(),message:'คำนวณเส้นทาง '+routes.length+' ใบงาน'});save();render();toast(pool.length?'ไรเดอร์ไม่เพียงพอ เหลือ '+pool.length+' ออเดอร์รอจัดสรร':'จัดเส้นทางเรียบร้อย · '+routes.length+' ใบงาน')}
function totals(){let boxes=activeOrders().reduce((s,o)=>s+o.boxes,0),delivery=state.routes.reduce((s,r)=>s+routeMetrics(r.ids).deliveries.reduce((a,d)=>a+d.d*(state.orders.find(o=>o.id===d.id)?.boxes||0)*2,0),0),wages=state.routes.length*15;return {boxes,sales:boxes*65,food:boxes*40,delivery,wages,profit:boxes*25-delivery-wages,distance:state.routes.reduce((s,r)=>s+routeMetrics(r.ids).distance,0),minutes:state.routes.reduce((s,r)=>s+routeMetrics(r.ids).time,0)}}
function badge(s){let success=['ส่งสำเร็จ','เสร็จสิ้น'],error=['ส่งไม่สำเร็จ','อาจส่งไม่ทัน','งานล่าช้า','ผิดพลาด','ยกเลิก'],follow=['รอจัดส่ง','กำลังจัดส่ง','พร้อมออกส่ง','รอรับงาน','ต้องติดตาม'],primary=['จัดสรรไรเดอร์แล้ว','ทันเวลา'];let kind=success.includes(s)?'success':error.includes(s)?'error':follow.includes(s)?'follow':primary.includes(s)?'primary':'neutral';return `<span class="badge status-${kind}">${esc(s)}</span>`}function go(p){page=p;query='';filter='all';location.hash=p;$('#sidebar').classList.remove('open');render()}function title(t,s,buttons=''){return `<div class="heading"><div><div class="eyebrow">LUNCH DELIVERY WORKSPACE</div><h1>${t}</h1><div class="sub">${s}</div></div><div>${buttons}</div></div>`}function stats(){let t=totals();return `<div class="stats">${[['ออเดอร์วันนี้',activeOrders().length,'ออเดอร์','▤',t.boxes+' กล่องพร้อมจัดส่ง'],['ไรเดอร์ที่ใช้งาน',state.routes.length,'/ '+state.riders.length+' คน','♙','รับได้สูงสุด 3 ออเดอร์ / คน'],['ยอดขายรวม','฿'+money(t.sales),'','฿','ราคาขาย 65 บาท / กล่อง'],['กำไรโดยประมาณ','฿'+money(t.profit),'','↗','หักต้นทุนและค่าจัดส่งแล้ว']].map(([a,b,c,d,e])=>`<div class="card"><div class="stat-top">${a}<span class="stat-icon">${d}</span></div><div class="value">${b}<small>${c}</small></div><span class="sub">${e}</span></div>`).join('')}</div>`}
function xy(c){return [400+(c.lng-shop.lng)*13000,195-(c.lat-shop.lat)*12000]}function map(only=null){let routes=only===null?state.routes:state.routes.filter(r=>r.rider===only);return `<div class="map"><div class="map-label">◉ &nbsp; โซนมหาวิทยาลัยมหาสารคาม</div><svg viewBox="0 0 800 390" role="img" aria-label="แผนผังจำลองเส้นทางไรเดอร์"><defs><pattern id="blocks" width="92" height="77" patternUnits="userSpaceOnUse"><rect x="9" y="8" width="74" height="58" rx="8" fill="#e7ebdf"/><path d="M0 0H92 M0 0V77" stroke="white" stroke-width="12"/></pattern></defs><rect width="800" height="390" fill="url(#blocks)"/><path d="M-30 315 Q170 235 280 325 T840 260" fill="none" stroke="#c8ded9" stroke-width="30"/><path d="M-40 80L820 300M180 -20L400 420M670 -20L460 420" fill="none" stroke="#fff" stroke-width="17"/><path d="M-40 80L820 300M180 -20L400 420M670 -20L460 420" fill="none" stroke="#e3d9c4" stroke-width="2"/><rect x="320" y="138" width="150" height="107" rx="25" fill="#d5e3c8"/><text x="396" y="165" text-anchor="middle" font-size="11" fill="#6a8760">มหาวิทยาลัยมหาสารคาม</text><text x="140" y="65" font-size="11" fill="#8c9a85">ขามเรียง</text><text x="590" y="338" font-size="11" fill="#8c9a85">ท่าขอนยาง</text>${routes.map(r=>{let pts=[[400,195],...r.ids.map(id=>xy(customer(state.orders.find(o=>o.id===id).customer)))];return `<polyline points="${pts.map(x=>x.join(',')).join(' ')}" fill="none" stroke="${colors[r.rider%8]}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>${pts.slice(1).map((p,i)=>`<circle cx="${p[0]}" cy="${p[1]}" r="10" fill="${colors[r.rider%8]}" stroke="white" stroke-width="2"/><text x="${p[0]}" y="${p[1]+4}" text-anchor="middle" fill="white" font-size="10">${i+1}</text>`).join('')}`}).join('')}${!routes.length?state.customers.map(c=>{let [x,y]=xy(c);return `<circle cx="${x}" cy="${y}" r="5" fill="#ed784c" stroke="white" stroke-width="2"/>`}).join(''):''}<circle cx="400" cy="195" r="15" fill="#263e33" stroke="white" stroke-width="3"/><text x="400" y="200" fill="white" text-anchor="middle" font-size="17">⌂</text></svg><div class="map-bottom">แผนผังพิกัดจำลอง · เส้นตรง · ไม่ใช่เส้นทางถนนจริง</div></div><div class="legend">${routes.slice(0,8).map(r=>`<span><i class="dot" style="background:${colors[r.rider%8]}"></i>${esc(state.riders[r.rider].name)}</span>`).join('')}<span><i class="dot" style="background:#263e33"></i>จุดรับอาหาร</span></div>`}
function rows(orders,actions=false){return `<div class="tablewrap"><table><thead><tr><th>เลขออเดอร์</th><th>ลูกค้า / จุดส่ง</th><th>จำนวน</th><th>ยอดขาย</th><th>ไรเดอร์</th><th>สถานะ</th>${actions?'<th>จัดการ</th>':''}</tr></thead><tbody>${orders.map(o=>{let c=customer(o.customer),r=state.routes.find(r=>r.ids.includes(o.id));return `<tr><td class="orderid">#LF-${o.id}</td><td>${esc(c?.name)}<div class="sub" style="margin-top:4px">${esc(c?.address)}</div></td><td>${o.boxes} กล่อง</td><td>฿${money(o.boxes*65)}</td><td>${r?esc(state.riders[r.rider].name):'—'}</td><td>${badge(o.status)}</td>${actions?`<td><button class="small secondary" onclick="orderForm(${o.id})">แก้ไข</button> <button class="small secondary" onclick="removeOrder(${o.id})">ลบ</button></td>`:''}</tr>`}).join('')||'<tr><td colspan="7" class="empty">ไม่พบออเดอร์</td></tr>'}</tbody></table></div>`}
function riderList(){return state.riders.slice(0,5).map(r=>{let route=state.routes.find(x=>x.rider===r.id),ids=route?.ids||[],done=ids.filter(id=>state.orders.find(o=>o.id===id)?.status==='ส่งสำเร็จ').length;return `<div class="rider-row"><div class="rider-avatar" style="color:${colors[r.id]};background:${colors[r.id]}15">${esc(r.name[0])}</div><div class="rider-info"><strong>${esc(r.name)}</strong><div class="sub">${ids.length} จุดส่ง · ${ids.reduce((s,id)=>s+(state.orders.find(o=>o.id===id)?.boxes||0),0)} กล่อง</div><div class="progress"><span style="width:${ids.length?done/ids.length*100:0}%;background:${colors[r.id]}"></span></div></div>${badge(ids.length?(done===ids.length?'เสร็จสิ้น':'พร้อมออกส่ง'):'ว่าง')}</div>`}).join('')}
function dashboard(){let t=totals(),lateCount=state.routes.filter(late).length;return title('ภาพรวมมื้อเที่ยงวันนี้','อาทิตย์ 11 ตุลาคม 2569 · จัดการทุกการส่งในที่เดียว',`<button onclick="go('routes')">⌁ &nbsp; จัดเส้นทางอัตโนมัติ</button>`)+stats()+`<div class="grid"><section class="card"><div class="section-head"><div><h2>ภาพรวมการจัดส่ง</h2><div class="sub">พื้นที่ให้บริการรอบ มมส. · ประมาณ 3 กิโลเมตร</div></div><span class="live">● ${state.routes.length} เส้นทาง</span></div>${map()}</section><section class="card"><div class="section-head"><div><h2>ทีมไรเดอร์</h2><div class="sub">ติดตามใบงานและความคืบหน้า</div></div><button class="secondary small" onclick="go('jobs')">ดูใบงาน ↗</button></div>${riderList()}<p class="sub" style="margin-top:18px">ไรเดอร์ทั้งหมด ${state.riders.length} คน · สูงสุด ${state.riders.length*3} ออเดอร์ต่อรอบ</p></section></div><div class="banner ${lateCount?'error':!state.routes.length?'attention':''}"><span class="symbol">${lateCount?'⚠':'✓'}</span><div><strong>${state.routes.length?(lateCount?lateCount+' เส้นทางอาจส่งไม่ทัน':'ทุกเส้นทางคาดว่าจะส่งทัน 12:30 น.'):'พร้อมวางแผนมื้อเที่ยงแล้ว'}</strong><p>ออกจากร้าน ${state.settings.depart} น. · ความเร็วประมาณ 30 กม./ชม. · เผื่อส่ง ${state.settings.delay} นาที / จุด</p></div><button onclick="go('routes')">ตรวจสอบเส้นทาง →</button></div><section class="card"><div class="section-head"><div><h2>ออเดอร์ล่าสุด</h2><div class="sub">รายการที่ต้องจัดส่งในรอบมื้อเที่ยง</div></div><button class="secondary small" onclick="go('orders')">ดูทั้งหมด →</button></div>${rows(state.orders.slice(-5).reverse())}</section>`}
function customers(){let list=state.customers.filter(c=>(c.name+c.phone+c.address).includes(query));return title('ข้อมูลลูกค้า','จัดการข้อมูลติดต่อและพิกัดจุดส่ง',`<button onclick="customerForm()">＋ เพิ่มลูกค้า</button>`)+`<div class="toolbar"><input placeholder="ค้นหาชื่อ เบอร์โทร หรือที่อยู่" value="${esc(query)}" oninput="query=this.value;renderListCustomers()" aria-label="ค้นหาลูกค้า"></div><div class="grid"><section class="card" id="customerlist">${customerTable(list)}</section><section class="card"><h2>ตำแหน่งลูกค้า</h2><p class="sub">เลือกพิกัดจริงของลูกค้าจากแผนที่ได้</p>${map(-1)}</section></div>`}function customerTable(list){return `<div class="tablewrap"><table><thead><tr><th>ลูกค้า</th><th>ที่อยู่ / พิกัด</th><th></th></tr></thead><tbody>${list.map(c=>`<tr><td>${esc(c.name)}<div class="sub">${esc(c.phone)}</div></td><td>${esc(c.address)}<div class="sub">${c.lat.toFixed(5)}, ${c.lng.toFixed(5)}</div></td><td><button class="secondary small" onclick="customerForm(${c.id})">แก้ไข</button></td></tr>`).join('')}</tbody></table></div>`}function renderListCustomers(){$('#customerlist').innerHTML=customerTable(state.customers.filter(c=>(c.name+c.phone+c.address).includes(query)))}
function orders(){return title('จัดการออเดอร์','ตรวจสอบ แก้ไข และเตรียมรายการสำหรับจัดส่ง',`<button class="secondary" onclick="simulate()">＋ จำลองออเดอร์</button> <button onclick="orderForm()">＋ เพิ่มออเดอร์</button>`)+stats()+`<section class="card"><div class="toolbar"><input aria-label="ค้นหาออเดอร์" placeholder="ค้นหาเลขออเดอร์ หรือชื่อลูกค้า" value="${esc(query)}" oninput="query=this.value;orderList()"><select aria-label="กรองสถานะ" onchange="filter=this.value;orderList()"><option value="all">ทุกสถานะ</option>${['รอจัดส่ง','จัดสรรไรเดอร์แล้ว','กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ','ยกเลิก'].map(s=>`<option ${filter===s?'selected':''}>${s}</option>`).join('')}</select></div><div id="orderlist">${rows(filteredOrders(),true)}</div></section>`}function filteredOrders(){return state.orders.filter(o=>(String(o.id)+customer(o.customer)?.name).includes(query)&&(filter==='all'||o.status===filter))}function orderList(){$('#orderlist').innerHTML=rows(filteredOrders(),true)}
function routes(){return title('จัดเส้นทางและแบ่งงาน','วางแผนจากจุดรับอาหารที่ร้าน · สูงสุด 3 ออเดอร์ต่อไรเดอร์',`<button class="secondary" onclick="calculate(true)">↻ คำนวณใหม่</button> <button onclick="calculate()">⌁ คำนวณเส้นทาง</button>`)+`<div class="toolbar"><label>เวลาออกส่ง <input type="time" value="${state.settings.depart}" onchange="state.settings.depart=this.value;save();render()"></label><label>เวลาต่อจุด (นาที) <input style="width:80px" type="number" min="0" max="30" value="${state.settings.delay}" onchange="state.settings.delay=Math.max(0,Math.min(30,+this.value));save();render()"></label><span class="badge status-primary">กำหนดส่งก่อน 12:30 น.</span><button class="secondary" onclick="setShop()">⌂ ตั้งจุดรับอาหาร</button></div><div class="grid"><section class="card"><div class="section-head"><div><h2>แผนการจัดส่ง</h2><div class="sub">จัดกลุ่มตามมุมพิกัด และเลือกจุดใกล้ที่สุดในแต่ละกลุ่ม</div></div><span class="badge">${state.routes.length} ใบงาน</span></div>${map()}<div class="note">ใช้ระยะทางถนนจาก OSRM เมื่อโหลดสำเร็จ เส้นประและใบงานที่ยังไม่ได้ข้อมูลใช้ระยะเส้นตรงชั่วคราว เวลาใช้ความเร็ว 30 กม./ชม. และเวลาส่งต่อจุด ไม่รวมจราจรสด<br>คำนวณใหม่จะคงใบงานที่เริ่มส่งแล้วไว้</div></section><section>${state.routes.length?state.routes.map(r=>routeCard(r)).join(''):'<div class="card empty">กด “คำนวณเส้นทาง” เพื่อสร้างใบงาน</div>'}</section></div>${activeOrders().filter(o=>o.status==='รอจัดส่ง').length?`<div class="note">มี ${activeOrders().filter(o=>o.status==='รอจัดส่ง').length} ออเดอร์รอจัดสรร หากเกินความจุของทีม ต้องเพิ่มไรเดอร์หรือปรับรอบส่ง</div>`:''}`}
function routeCard(r){let m=routeMetrics(r.ids),b=r.ids.reduce((s,id)=>s+(state.orders.find(o=>o.id===id)?.boxes||0),0);return `<div class="card route-card"><div class="section-head"><h3><i class="dot" style="background:${colors[r.rider%8]}"></i>${esc(state.riders[r.rider].name)} · LF-R${r.rider+1}</h3>${badge(late(r)?'อาจส่งไม่ทัน':'ทันเวลา')}</div><div class="sub">${r.ids.length} ออเดอร์ · ${b} กล่อง · ${m.distance.toFixed(2)} กม.</div><div class="stops">ร้าน → ${r.ids.map(id=>esc(customer(state.orders.find(o=>o.id===id).customer).name)).join(' → ')}</div><div class="section-head" style="margin-bottom:0"><span class="sub">เสร็จประมาณ <strong>${time(m.time)}</strong></span><button class="small secondary" onclick="selected=${r.rider};go('jobs')">ดูใบงาน ↗</button></div>${late(r)?'<p class="sub" style="color:#b54747">ปรับเวลาออกส่ง ลดงานต่อใบงาน หรือเพิ่มไรเดอร์</p>':''}</div>`}
function reports(){let t=totals();return title('รายงานและสรุปกำไร','ประมาณการรอบมื้อเที่ยง · ข้อมูลอัปเดตจากออเดอร์และใบงาน',`<button class="secondary" onclick="exportCSV()">↓ ดาวน์โหลด CSV</button>`)+stats()+`<div class="two"><section class="card"><h2>รายรับและต้นทุน</h2>${[['ยอดขาย ('+t.boxes+' × 65 บาท)',t.sales],['ต้นทุนอาหาร ('+t.boxes+' × 40 บาท)',t.food],['ค่าเรียกไรเดอร์ ('+state.routes.length+' ใบงาน × 15 บาท)',t.wages],['ค่าส่งตามระยะทางถึงแต่ละจุด',t.delivery]].map(([l,v])=>`<div class="detail"><span>${l}</span><strong>฿${money(v)}</strong></div>`).join('')}<div class="detail"><strong>กำไรโดยประมาณ</strong><strong style="color:var(--green);font-size:22px">฿${money(t.profit)}</strong></div><div class="note">กำไร = ยอดขาย − ต้นทุนอาหาร − ค่าเรียกไรเดอร์ − ค่าส่ง<br>ค่าส่งแต่ละออเดอร์ = ระยะสะสมจากร้านถึงจุดส่ง × จำนวนกล่อง × 2 บาท<br>สมมติค่าเรียก 15 บาทต่อใบงาน ค่าส่งเป็นค่าใช้จ่ายของร้าน ไม่รวมขากลับ และยังไม่ใช่ราคาจากผู้ให้บริการจริง · ระยะทางใช้ถนนจริงเมื่อโหลดสำเร็จ หากยังไม่สำเร็จใช้ค่าประมาณเส้นตรง</div></section><section class="card"><h2>ภาพรวมการจัดส่ง</h2><div class="detail"><span>ระยะทางรวม</span><strong>${t.distance.toFixed(2)} กม.</strong></div><div class="detail"><span>เวลารวมของทุกใบงาน</span><strong>${Math.ceil(t.minutes)} นาที</strong></div><div class="detail"><span>ใบงานที่เสี่ยงล่าช้า</span><strong>${state.routes.filter(late).length} ใบงาน</strong></div><h3 style="margin-top:28px">ระยะทางแต่ละไรเดอร์</h3>${state.routes.map(r=>{let m=routeMetrics(r.ids);return `<div class="barrow"><label>${esc(state.riders[r.rider].name)}</label><div class="bar"><div style="width:${Math.min(100,m.distance/8*100)}%;background:${colors[r.rider%8]}"></div></div><span>${m.distance.toFixed(1)} กม.</span></div>`}).join('')||'<p class="sub">ยังไม่มีใบงาน</p>'}</section></div><section class="card" style="margin-top:22px"><h2>ที่มาของค่าส่ง</h2><p class="sub">${roadSummary()} · เวลาประมาณที่ 30 กม./ชม.</p><p class="sub">ตัวอย่าง: 6 กล่อง × 2 กม. × 2 บาท = 24 บาท + ค่าเรียก 15 บาท = 39 บาท</p><div class="tablewrap"><table><thead><tr><th>ใบงาน / ออเดอร์</th><th>ระยะสะสม</th><th>กล่อง</th><th>ค่าส่ง</th></tr></thead><tbody>${state.routes.flatMap(r=>routeMetrics(r.ids).deliveries.map(d=>{let o=state.orders.find(o=>o.id===d.id);return `<tr><td>LF-R${r.rider+1} / #LF-${o.id}</td><td>${d.d.toFixed(2)} กม.</td><td>${o.boxes}</td><td>฿${money(d.d*o.boxes*2)}</td></tr>`})).join('')}</tbody></table></div></section>`}
function riderSelect(){return `<div class="toolbar"><select onchange="selected=+this.value;selectedOrder=null;render()" aria-label="เลือกไรเดอร์">${state.riders.map(r=>`<option value="${r.id}" ${selected===r.id?'selected':''}>${esc(r.name)} · LF-R${r.id+1}</option>`).join('')}</select><input id="worksheet" placeholder="เลขใบงาน เช่น LF-R1" aria-label="เลขใบงาน"><button class="secondary" onclick="findJob()">ค้นหาใบงาน</button></div>`}function findJob(){let n=/^LF-R([1-8])$/i.exec($('#worksheet').value.trim());if(!n){toast('กรอกเลขใบงาน LF-R1 ถึง LF-R8');return}selected=+n[1]-1;selectedOrder=null;render()}
function jobs(){let r=state.routes.find(r=>r.rider===selected),ids=r?.ids||[],m=routeMetrics(ids),boxes=ids.reduce((s,id)=>s+(state.orders.find(o=>o.id===id)?.boxes||0),0);return `<div class="mobile-shell">${title('ใบงานของฉัน','รับอาหารจากร้าน และจัดส่งตามลำดับจุด')}${riderSelect()}<div class="card" style="background:#263e33;color:white"><div class="section-head"><h2>สวัสดี ${esc(state.riders[selected].name)} 👋</h2><span class="badge">LF-R${selected+1}</span></div><div class="value">${boxes}<small style="color:#b5c9bc">กล่องที่ต้องรับ</small></div><div style="color:#b5c9bc;font-size:12px">${ids.length} จุดส่ง · ${m.distance.toFixed(2)} กม. · เสร็จประมาณ ${r?time(m.time):'—'}</div></div><div class="card" style="margin-top:18px"><div class="section-head"><h2>ลำดับการจัดส่ง</h2><button class="secondary small" onclick="go('navigation')">แผนที่ ↗</button></div>${ids.map((id,i)=>stop(id,i,m)).join('')||'<div class="empty">ยังไม่ได้รับมอบหมายงาน<br>ให้เจ้าของร้านคำนวณเส้นทางก่อน</div>'}${ids.some(id=>state.orders.find(o=>o.id===id)?.status==='จัดสรรไรเดอร์แล้ว')?'<button style="width:100%;margin-top:20px" onclick="startJob()">รับอาหารแล้ว · เริ่มจัดส่ง</button>':''}</div></div>`}
function stop(id,i,m){let o=state.orders.find(o=>o.id===id),c=customer(o.customer);return `<div class="stop"><div class="stop-number">${i+1}</div><div class="stop-text"><h3>${esc(c.name)}</h3><div class="sub">${esc(c.address)}</div><p class="sub">${o.boxes} กล่อง · ถึงประมาณ ${time(m.deliveries[i].minutes)}</p>${badge(o.status)}</div><button class="secondary small" onclick="selectedOrder=${id};go('delivery')">รายละเอียด →</button></div>`}function startJob(){let r=state.routes.find(r=>r.rider===selected);r?.ids.forEach(id=>{let o=state.orders.find(o=>o.id===id);if(o.status==='จัดสรรไรเดอร์แล้ว')o.status='กำลังจัดส่ง'});save();render();toast('เริ่มจัดส่งแล้ว')}
function navigation(){let r=state.routes.find(r=>r.rider===selected),m=routeMetrics(r?.ids||[]);return `<div class="mobile-shell">${title('แผนที่นำทาง','เรียงจุดส่งจากร้านตามใบงานที่เลือก')}${riderSelect()}<section class="card">${map(selected)}${r?.ids.map((id,i)=>{let o=state.orders.find(o=>o.id===id),c=customer(o.customer);return `<div class="stop"><div class="stop-number">${i+1}</div><div class="stop-text"><h3>${esc(c.name)}</h3><p class="sub">${esc(c.address)} · ${o.boxes} กล่อง</p><a class="link" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${c.lat},${c.lng}&travelmode=driving">เปิด Google Maps ↗</a></div></div>`}).join('')||'<div class="empty">ไม่มีเส้นทางสำหรับไรเดอร์คนนี้</div>'}</section><div class="note">พิกัดตัวอย่างสำหรับทดสอบ ตรวจสอบและแก้ไขพิกัดลูกค้าก่อนนำทางจริง</div></div>`}
function delivery(){let r=state.routes.find(r=>r.rider===selected),o=state.orders.find(o=>o.id===selectedOrder&&r?.ids.includes(o.id))||state.orders.find(o=>o.id===r?.ids[0]);if(!o)return `<div class="mobile-shell">${title('รายละเอียดจัดส่ง','เลือกงานจากใบงานของฉัน')}${riderSelect()}<div class="card empty">ไม่มีงานจัดส่ง <button onclick="go('jobs')">ดูใบงาน</button></div></div>`;selectedOrder=o.id;let c=customer(o.customer);return `<div class="mobile-shell">${title('รายละเอียดจัดส่ง','#LF-'+o.id+' · ใบงาน LF-R'+(selected+1),'<button class="secondary" onclick="go(\'jobs\')">← ใบงาน</button>')}<section class="card"><div class="section-head"><h2>${esc(c.name)}</h2>${badge(o.status)}</div><div class="detail"><span>จำนวนอาหาร</span><strong>${o.boxes} กล่อง</strong></div><div class="detail"><span>เบอร์โทรศัพท์</span><a class="link" href="tel:${esc(c.phone)}">${esc(c.phone)} ↗</a></div><div class="detail"><span>ที่อยู่</span><strong>${esc(c.address)}</strong></div><p style="margin-top:18px">${esc(c.note)}</p><p class="sub">พิกัด ${c.lat.toFixed(5)}, ${c.lng.toFixed(5)}</p><a class="link" style="display:block;margin:18px 0" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${c.lat},${c.lng}&travelmode=driving">➤ เปิด Google Maps</a><div class="actions"><button class="secondary" onclick="updateStatus('ส่งไม่สำเร็จ')">ส่งไม่สำเร็จ</button><button onclick="updateStatus('ส่งสำเร็จ')">✓ ส่งสำเร็จ</button></div>${o.reason?`<div class="note">หมายเหตุ: ${esc(o.reason)}</div>`:''}</section><div class="note">หากลูกค้าไม่อยู่ ให้โทรติดต่อก่อน แล้วบันทึกเหตุผลเมื่อส่งไม่สำเร็จ</div></div>`}
function updateStatus(s){let o=state.orders.find(o=>o.id===selectedOrder);if(!o)return;if(s==='ส่งไม่สำเร็จ'){let reason=prompt('เหตุผลที่ส่งไม่สำเร็จ เช่น ลูกค้าไม่อยู่');if(!reason?.trim())return;o.reason=reason.trim()}else delete o.reason;o.status=s;state.history.push({at:new Date().toISOString(),message:'#LF-'+o.id+' '+s});save();render();toast('บันทึกสถานะแล้ว')}
function welcome(){return title('เลือกมุมมองการใช้งาน','ไม่ต้องลงชื่อเข้าใช้ · สลับมุมมองได้จากเมนูด้านบน')+`<div class="rolegrid"><section class="card rolecard"><div class="big-icon">◫</div><h2>เจ้าของร้าน</h2><p class="sub">จัดการลูกค้าและออเดอร์ วางแผนเส้นทาง และตรวจสอบต้นทุนกำไรในที่เดียว</p><button style="margin-top:22px" onclick="go('dashboard')">เปิดหน้าจัดการร้าน →</button></section><section class="card rolecard"><div class="big-icon">➤</div><h2>ไรเดอร์</h2><p class="sub">ตรวจสอบจำนวนกล่อง ดูจุดส่ง เปิดแผนที่นำทาง และอัปเดตสถานะการจัดส่ง</p><button style="margin-top:22px" onclick="go('jobs')">เปิดใบงานไรเดอร์ →</button></section></div><div class="note">เว็บต้นแบบสำหรับทดลอง UI และกฎการจัดส่ง ข้อมูลบันทึกในเบราว์เซอร์นี้ ผู้ใช้สามารถเลือกดูใบงานของทุกไรเดอร์ได้</div>`}
function render(){let rider=['jobs','navigation','delivery'].includes(page);$('#role').value=rider?'rider':'owner';$('#crumb').textContent=menus.find(m=>m[0]===page)?.[2]||'';$('#nav').innerHTML=menus.map(([p,i,t],j)=>`${j===6?'<div class="navlabel">ON THE ROAD / ไรเดอร์</div>':''}<button class="${page===p?'active':''}" onclick="go('${p}')"><span>${i}</span>${t}</button>`).join('');$('#app').innerHTML=({dashboard,customers,orders,routes,reports,welcome,jobs,navigation,delivery}[page]||dashboard)()+`<footer><span>LunchFlow · ส่งด่วนมื้อเที่ยง</span><span>ข้อมูลจำลอง · บันทึกในเบราว์เซอร์</span></footer>`}
function invalidate(){state.routes=state.routes.filter(r=>r.ids.some(id=>['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(state.orders.find(o=>o.id===id)?.status)));let retained=new Set(state.routes.flatMap(r=>r.ids));state.orders.forEach(o=>{if(o.status==='จัดสรรไรเดอร์แล้ว'&&!retained.has(o.id))o.status='รอจัดส่ง'});save()}
function showForm(html){$('#modal').innerHTML=html;$('#modal').showModal()}function cancelForm(){$('#modal').close()}
function customerForm(id){let c=customer(id)||{name:'',phone:'',address:'',lat:16.246,lng:103.25,note:''};showForm(`<h2>${id?'แก้ไข':'เพิ่ม'}ลูกค้า</h2><form onsubmit="saveCustomer(event,${id||0})"><label>ชื่อ</label><input name="name" value="${esc(c.name)}" required maxlength="80"><label>เบอร์โทรศัพท์</label><input name="phone" value="${esc(c.phone)}" required pattern="[0-9]{10}" inputmode="tel" title="ตัวเลข 10 หลัก"><label>ที่อยู่</label><input name="address" value="${esc(c.address)}" required maxlength="200"><div class="two"><div><label>ละติจูด</label><input name="lat" type="number" step="any" min="-90" max="90" value="${c.lat}" required></div><div><label>ลองจิจูด</label><input name="lng" type="number" step="any" min="-180" max="180" value="${c.lng}" required></div></div><label>รายละเอียดจุดส่ง</label><input name="note" value="${esc(c.note)}" maxlength="200"><div class="actions"><button type="button" class="secondary" onclick="cancelForm()">ยกเลิก</button><button>บันทึก</button></div></form>`)}
function saveCustomer(e,id){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));d.lat=+d.lat;d.lng=+d.lng;if(km(shop,d)>3){toast('พิกัดต้องอยู่ในรัศมี 3 กม. จากจุดรับอาหารจำลอง');return}if(id&&state.orders.some(o=>o.customer===id&&['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(o.status))){toast('ไม่สามารถเปลี่ยนข้อมูลลูกค้าของงานที่เริ่มส่งแล้ว');return}d.id=id||Math.max(0,...state.customers.map(c=>c.id))+1;if(id)Object.assign(customer(id),d);else state.customers.push(d);invalidate();cancelForm();render();toast('บันทึกลูกค้าแล้ว · คำนวณเส้นทางใหม่เมื่อข้อมูลเปลี่ยน')}
function orderForm(id){let o=state.orders.find(o=>o.id===id)||{customer:state.customers[0]?.id,boxes:1,status:'รอจัดส่ง'};if(['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(o.status)){toast('งานเริ่มส่งแล้ว ให้เปลี่ยนสถานะจากรายละเอียดจัดส่ง');return}showForm(`<h2>${id?'แก้ไข':'เพิ่ม'}ออเดอร์</h2><form onsubmit="saveOrder(event,${id||0})"><label>ลูกค้า</label><select name="customer">${state.customers.map(c=>`<option value="${c.id}" ${o.customer===c.id?'selected':''}>${esc(c.name)}</option>`).join('')}</select><label>จำนวนข้าวกล่อง (ไม่เกิน 3)</label><input name="boxes" type="number" min="1" max="3" value="${o.boxes}" required><label>สถานะ</label><select name="status"><option value="รอจัดส่ง">รอจัดส่ง</option><option value="ยกเลิก" ${o.status==='ยกเลิก'?'selected':''}>ยกเลิก</option></select><div class="actions"><button type="button" class="secondary" onclick="cancelForm()">ยกเลิก</button><button>บันทึก</button></div></form>`)}function saveOrder(e,id){e.preventDefault();let d=Object.fromEntries(new FormData(e.target));d.customer=+d.customer;d.boxes=+d.boxes;if(!Number.isInteger(d.boxes)||d.boxes<1||d.boxes>3)return;d.id=id||Math.max(1000,...state.orders.map(o=>o.id))+1;if(id)Object.assign(state.orders.find(o=>o.id===id),d);else state.orders.push(d);invalidate();cancelForm();render();toast('บันทึกออเดอร์แล้ว · กรุณาคำนวณเส้นทางใหม่')}
function removeOrder(id){let o=state.orders.find(o=>o.id===id);if(['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(o.status)){toast('ไม่สามารถลบออเดอร์ที่เริ่มส่งแล้ว');return}if(!confirm('ลบออเดอร์ #LF-'+id+'?'))return;state.orders=state.orders.filter(o=>o.id!==id);invalidate();render();toast('ลบออเดอร์แล้ว')}
function simulate(){let available=state.customers.filter(c=>!activeOrders().some(o=>o.customer===c.id));if(!available.length)available=state.customers;let c=available[Math.floor(Math.random()*available.length)];state.orders.push({id:Math.max(1000,...state.orders.map(o=>o.id))+1,customer:c.id,boxes:1+Math.floor(Math.random()*3),status:'รอจัดส่ง'});invalidate();render();toast('เพิ่มออเดอร์จำลองแล้ว · คำนวณเส้นทางใหม่ได้ทันที')}
function exportCSV(){let t=totals();let lines=[['รายการ','จำนวน'],['ยอดขาย',t.sales],['ต้นทุนอาหาร',t.food],['ค่าเรียกไรเดอร์',t.wages],['ค่าส่ง',t.delivery.toFixed(2)],['กำไรประมาณการ',t.profit.toFixed(2)],['ระยะทางรวม กม. (ถนนจริงหรือประมาณการตามข้อมูลที่โหลดได้)',t.distance.toFixed(2)],['เวลารวม นาที',Math.ceil(t.minutes)]];let url=URL.createObjectURL(new Blob(['\ufeff'+lines.map(l=>l.join(',')).join('\n')],{type:'text/csv;charset=utf-8'}));let a=document.createElement('a');a.href=url;a.download='LunchFlow-report.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('ดาวน์โหลดรายงานแล้ว')}
const iconPaths={store:'M3 10h18M4 10v11h16V10M3 10l2-7h14l2 7M9 21v-7h6v7M3 10q3 4 6 0q3 4 6 0q3 4 6 0',dashboard:'M3 3h7v8H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 15h7v6H3z',customers:'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.9M13 7a4 4 0 1 1-8 0a4 4 0 0 1 8 0',orders:'M8 3h8v4H8zM8 5H5v16h14V5h-3M8 12h8M8 16h5',routes:'M5 5a2 2 0 1 1-4 0a2 2 0 0 1 4 0M23 19a2 2 0 1 1-4 0a2 2 0 0 1 4 0M5 5h11a4 4 0 0 1 0 8H8a3 3 0 0 0 0 6h11',reports:'M4 3v18h17M8 16v-4M13 16V8M18 16V5',welcome:'M4 7h16M4 17h16M16 3l4 4-4 4M8 13l-4 4 4 4',jobs:'M8 3h8v4H8zM8 5H5v16h14V5h-3M8 12h1M12 12h4M8 16h1M12 16h4',navigation:'M21 3L3 10l8 3 3 8zM11 13l5-5',delivery:'M12 21s7-6 7-12a7 7 0 0 0-14 0c0 6 7 12 7 12M14.5 9a2.5 2.5 0 1 1-5 0a2.5 2.5 0 0 1 5 0',rider:'M7 18a3 3 0 1 1-6 0a3 3 0 0 1 6 0M23 18a3 3 0 1 1-6 0a3 3 0 0 1 6 0M4 18l5-9h7l4 9M9 9l5 9H4M15 5h3l2 4M8 6h4',profit:'M3 17l6-6 4 4 8-10M15 5h6v6',money:'M12 2v20M17 5H9a3 3 0 0 0 0 6h6a3 3 0 0 1 0 6H6',clock:'M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0M12 7v5l3 2'};
function icon(name){return `<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="${iconPaths[name]||iconPaths.jobs}"/></svg>`}
function contextSwitch(rider){return `<div class="context-switch" aria-label="เลือกฝั่งการใช้งาน"><button class="${!rider?'current':''}" onclick="go('dashboard')">${icon('store')} ร้านอาหาร</button><button class="${rider?'current':''}" onclick="go('jobs')">${icon('rider')} Rider</button></div>`}
function hero(){let waiting=activeOrders().filter(o=>o.status==='รอจัดส่ง').length;return `<section class="dispatch-hero"><div><div class="hero-overline">TODAY’S LUNCH SERVICE</div><h2>ทุกมื้อเที่ยง พร้อมส่งตรงเวลา</h2><p>${activeOrders().length} ออเดอร์ · ${totals().boxes} กล่อง · ${state.routes.length} ใบงานในรอบนี้</p><p class="hero-chip">${waiting?waiting+' ออเดอร์รอจัดสรร':'แผนจัดส่งพร้อมสำหรับทีมไรเดอร์'}</p></div><div class="hero-right"><div class="hero-time"><div class="label">เริ่มออกส่ง</div><strong>${state.settings.depart}</strong><small>จุดรับอาหารที่ร้าน</small></div><div class="hero-line"></div><div class="hero-time"><div class="label">เป้าหมายถึงลูกค้า</div><strong style="color:#f5bc8e">12:30</strong><small>ส่งก่อนเวลามื้อเที่ยง</small></div></div></section>`}
const oldDashboard=dashboard;
dashboard=function(){let html=oldDashboard(),date=new Intl.DateTimeFormat('th-TH',{dateStyle:'full'}).format(new Date());html=html.replace('อาทิตย์ 11 ตุลาคม 2569',date);const at=html.indexOf('<div class="stats">');return html.slice(0,at)+hero()+html.slice(at)};
welcome=function(){return `<div class="start-choice"><div class="welcome-head"><div class="eyebrow">ONE LUNCH. TWO WORKSPACES.</div><h1>ส่งมื้อเที่ยงให้เป็นเรื่องง่าย</h1><p>เลือกพื้นที่ทำงานของคุณ<br>จัดการร้านอย่างเป็นระบบ และให้ไรเดอร์เห็นงานที่ต้องทำอย่างชัดเจน</p></div><div class="rolegrid"><section class="card rolecard"><div class="big-icon">${icon('store')}</div><div class="role-tag">RESTAURANT WORKSPACE</div><h2>สำหรับร้านอาหาร</h2><p class="sub">ภาพรวมการขาย การจัดการออเดอร์ และการวางแผนจัดส่ง<br>ครบทุกเครื่องมือสำหรับเตรียมรอบมื้อเที่ยง</p><div class="role-features"><span>จัดการลูกค้าและออเดอร์</span><span>แบ่งงานอัตโนมัติ</span><span>สรุปกำไรและต้นทุน</span></div><button onclick="go('dashboard')"><span>เข้าสู่หน้าจัดการร้าน</span><span>→</span></button></section><section class="card rolecard rider-choice"><div class="big-icon">${icon('rider')}</div><div class="role-tag">RIDER WORKSPACE</div><h2>สำหรับ Rider</h2><p class="sub">ใบงานที่อ่านง่าย ลำดับจุดส่งที่ชัดเจน และปุ่มนำทาง<br>ออกแบบสำหรับการใช้งานบนโทรศัพท์มือถือ</p><div class="role-features"><span>ตรวจสอบใบงาน</span><span>เปิดแผนที่นำทาง</span><span>บันทึกผลจัดส่ง</span></div><button onclick="go('jobs')"><span>เข้าสู่ใบงาน Rider</span><span>→</span></button></section></div><div class="choice-foot">ไม่ต้อง Login · สลับฝั่งได้ทุกเมื่อ · ข้อมูลทดลองบันทึกในเบราว์เซอร์</div></div>`};
jobs=function(){let r=state.routes.find(r=>r.rider===selected),ids=r?.ids||[],m=routeMetrics(ids),boxes=ids.reduce((s,id)=>s+(state.orders.find(o=>o.id===id)?.boxes||0),0),done=ids.filter(id=>state.orders.find(o=>o.id===id)?.status==='ส่งสำเร็จ').length;let status=ids.length?(done===ids.length?'ส่งครบทุกจุดแล้ว':ids.some(id=>state.orders.find(o=>o.id===id)?.status==='กำลังจัดส่ง')?'กำลังจัดส่ง':'พร้อมรับอาหารที่ร้าน'):'ยังไม่มีใบงาน';return `<div class="mobile-shell">${title('ใบงานของฉัน','ตรวจสอบอาหารก่อนออกส่ง และทำตามลำดับจุด')}${riderSelect()}<section class="card rider-jobhero"><div class="section-head"><div class="rider-greeting"><div class="rider-avatar">${esc(state.riders[selected].name[0])}</div><div><h2>สวัสดี ${esc(state.riders[selected].name)}</h2><div style="color:#a9cbb8;font-size:10px;margin-top:7px">${status}</div></div></div><span class="badge">LF-R${selected+1}</span></div><div class="value">${boxes}<small style="color:#a9cbb8;font-size:12px;margin-left:10px">กล่องที่ต้องรับ</small></div><div class="job-meta"><div>จุดส่งทั้งหมด<strong>${ids.length} จุด · สำเร็จ ${done}</strong></div><div>ระยะทางประมาณ<strong>${m.distance.toFixed(2)} กม.</strong></div><div>เสร็จประมาณ<strong>${r?time(m.time):'—'} น.</strong></div></div></section><div class="status-hint"><i>⌂</i><span>จุดเริ่มต้น: ร้านอาหาร · ออกส่ง ${state.settings.depart} น.</span></div><div class="card"><div class="section-head"><div><h2>เส้นทางของคุณ</h2><div class="sub">จัดส่งตามลำดับหมายเลขด้านล่าง</div></div><button class="secondary small" onclick="go('navigation')">${icon('navigation')} นำทาง</button></div>${ids.map((id,i)=>stop(id,i,m)).join('')||'<div class="empty">ยังไม่ได้รับมอบหมายงาน<br>ให้ร้านอาหารคำนวณเส้นทางก่อน</div>'}${ids.some(id=>state.orders.find(o=>o.id===id)?.status==='จัดสรรไรเดอร์แล้ว')?'<button style="width:100%;margin-top:20px" onclick="startJob()">รับอาหารแล้ว · เริ่มจัดส่ง →</button>':''}</div></div>`};
render=function(){let rider=['jobs','navigation','delivery'].includes(page),welcomeMode=page==='welcome';document.body.className=rider?'mode-rider':welcomeMode?'mode-welcome':'mode-owner';$('#role').value=rider?'rider':'owner';$('#crumb').textContent=menus.find(m=>m[0]===page)?.[2]||'';$('#sidebar').innerHTML=`<div class="brand"><i>${icon('navigation')}</i><div>LunchFlow<small>RESTAURANT OPERATIONS</small></div></div><div class="workspace-card">${icon('store')}<div>ร้านอาหาร · มมส.<span>จัดการรอบส่งมื้อเที่ยง</span></div></div><div class="navlabel">ร้านอาหาร / RESTAURANT</div><nav id="nav">${menus.filter(m=>!['jobs','navigation','delivery'].includes(m[0])).map(([p,i,t])=>`<button class="${page===p?'active':''}" ${page===p?'aria-current="page"':''} onclick="go('${p}')"><span>${icon(p)}</span>${p==='welcome'?'เลือกพื้นที่ทำงาน':t}</button>`).join('')}</nav><div class="sidebar-space"></div><div class="sidebottom"><strong>พร้อมส่งก่อน 12:30 น.</strong><br>จัดการทุกจุดส่งให้เป็นระบบ</div>`;document.querySelector('header').innerHTML=`<div class="header-brand"><div class="brand"><i>${icon(rider?'rider':'navigation')}</i><div>LunchFlow<small>${rider?'RIDER WORKSPACE':'ส่งด่วนมื้อเที่ยง'}</small></div></div></div><div><button class="hamburger" onclick="document.getElementById('sidebar').classList.toggle('open')" aria-label="เปิดเมนู">☰</button><span class="crumb">ร้านอาหาร &nbsp; / &nbsp; <span id="crumb">${esc(menus.find(m=>m[0]===page)?.[2]||'')}</span></span></div><div class="header-right">${!rider?`<span class="restaurant-stamp">${icon('store')} MSU · มหาสารคาม</span>`:''}${contextSwitch(rider)}<div class="avatar">${rider?'RD':'LF'}</div></div><select id="role" hidden aria-label="มุมมองปัจจุบัน"><option value="owner">ร้านอาหาร</option><option value="rider">Rider</option></select>`;$('#role').value=rider?'rider':'owner';let html=({dashboard,customers,orders,routes,reports,welcome,jobs,navigation,delivery}[page]||dashboard)();html=html.replaceAll('LUNCH DELIVERY WORKSPACE',rider?'RIDER / ON THE ROAD':'RESTAURANT / OPERATIONS');if(!rider){let icons=['orders','customers','money','profit'],i=0;html=html.replace(/<span class="stat-icon">[^<]*<\/span>/g,()=>`<span class="stat-icon">${icon(icons[i++%4])}</span>`)}$('#app').innerHTML=html+`<footer><span>LunchFlow / ${rider?'Rider Workspace':'Restaurant Workspace'}</span><span>ข้อมูลจำลอง · บันทึกในเบราว์เซอร์</span></footer><div class="semantic-legend" aria-label="ความหมายสีสถานะ"><span><i style="background:#2563eb"></i>เมนู / การทำงานหลัก</span><span><i style="background:#178344"></i>ส่งสำเร็จ</span><span><i style="background:#e3b321"></i>ต้องติดตาม</span><span><i style="background:#ce3e47"></i>ล่าช้า / ผิดพลาด</span></div>`;let bottom=document.querySelector('#rider-bottom');if(!bottom){bottom=document.createElement('nav');bottom.id='rider-bottom';bottom.className='rider-bottom';document.body.appendChild(bottom)}bottom.innerHTML=menus.filter(m=>['jobs','navigation','delivery'].includes(m[0])).map(([p,i,t])=>`<button onclick="go('${p}')" class="${page===p?'active':''}" ${page===p?'aria-current="page"':''}>${icon(p)}<span>${p==='jobs'?'ใบงาน':p==='navigation'?'นำทาง':'รายละเอียด'}</span></button>`).join('');};

const orderStatuses=['รอจัดส่ง','จัดสรรไรเดอร์แล้ว','กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ','ยกเลิก'];
orderForm=function(id){let o=state.orders.find(o=>o.id===id)||{customer:state.customers[0]?.id,boxes:1,status:'รอจัดส่ง'},started=['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(o.status),route=state.routes.find(r=>r.ids.includes(id));showForm(`<h2>${id?'แก้ไขออเดอร์ #LF-'+id:'เพิ่มออเดอร์'}</h2><form onsubmit="saveOrder(event,${id||0})"><label>ลูกค้า</label><select name="customer" ${started?'disabled':''}>${state.customers.map(c=>`<option value="${c.id}" ${o.customer===c.id?'selected':''}>${esc(c.name)}</option>`).join('')}</select><label>จำนวนข้าวกล่อง (ไม่เกิน 3)</label><input name="boxes" type="number" min="1" max="3" value="${o.boxes}" required ${started?'disabled':''}><div class="status-field"><label>สถานะออเดอร์ ${badge(o.status)}</label><select name="status" onchange="toggleReason(this.value)">${orderStatuses.map(s=>`<option value="${s}" ${s===o.status?'selected':''}>${s}</option>`).join('')}</select></div><div id="reason-field" ${['ส่งไม่สำเร็จ','ยกเลิก'].includes(o.status)?'':'hidden'}><label>เหตุผล / หมายเหตุ <span class="required-mark">กรุณาระบุเมื่อส่งไม่สำเร็จหรือยกเลิก</span></label><textarea name="reason" maxlength="300" placeholder="เช่น ลูกค้าไม่อยู่ ติดต่อไม่ได้ หรือยกเลิกโดยลูกค้า">${esc(o.reason||'')}</textarea></div><div class="form-note">${route?'ใบงาน LF-R'+(route.rider+1)+' · ไรเดอร์ '+esc(state.riders[route.rider].name):'ยังไม่มีใบงาน · คำนวณเส้นทางก่อนเลือกสถานะจัดสรรหรือจัดส่ง'}<br>${started?'งานเริ่มส่งแล้ว เปลี่ยนสถานะและหมายเหตุได้ โดยคงข้อมูลลูกค้าและจำนวนกล่องไว้':'หากเปลี่ยนลูกค้าหรือจำนวนกล่อง ระบบจะให้จัดเส้นทางใหม่'}<br>รอจัดส่งหรือยกเลิก: นำออเดอร์ออกจากใบงานเดิม</div><div class="actions"><button type="button" class="secondary" onclick="cancelForm()">ปิด</button><button>บันทึกการเปลี่ยนแปลง</button></div></form>`)};
function toggleReason(s){document.querySelector('#reason-field').hidden=!['ส่งไม่สำเร็จ','ยกเลิก'].includes(s)}
saveOrder=function(e,id){e.preventDefault();let fields=Object.fromEntries(new FormData(e.target)),old=state.orders.find(o=>o.id===id),started=old&&['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(old.status),customerId=started?old.customer:+fields.customer,boxes=started?old.boxes:+fields.boxes,status=fields.status,reason=(fields.reason||'').trim(),route=state.routes.find(r=>r.ids.includes(id));if(!Number.isInteger(boxes)||boxes<1||boxes>3||!customer(customerId)||!orderStatuses.includes(status)){toast('ตรวจสอบข้อมูลลูกค้า จำนวนกล่อง และสถานะ');return}if(['ส่งไม่สำเร็จ','ยกเลิก'].includes(status)&&!reason){toast('กรุณาระบุเหตุผลเมื่อส่งไม่สำเร็จหรือยกเลิก');return}let changed=old&&(old.customer!==customerId||old.boxes!==boxes);if(['จัดสรรไรเดอร์แล้ว','กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(status)&&(!route||changed)){toast(changed?'ข้อมูลจัดส่งเปลี่ยน เลือก “รอจัดส่ง” แล้วคำนวณเส้นทางใหม่':'กรุณาคำนวณเส้นทางเพื่อมอบหมายไรเดอร์ก่อนเลือกสถานะนี้');return}let next={id:id||Math.max(1000,...state.orders.map(o=>o.id))+1,customer:customerId,boxes,status};if(reason)next.reason=reason;if(old){Object.assign(old,next);if(!reason)delete old.reason}else state.orders.push(next);if(changed){invalidate()}else if(['รอจัดส่ง','ยกเลิก'].includes(status)){state.routes.forEach(r=>r.ids=r.ids.filter(orderId=>orderId!==id));state.routes=state.routes.filter(r=>r.ids.length)}state.history.push({at:new Date().toISOString(),message:'#LF-'+next.id+' '+status+(reason?' · '+reason:'')});save();cancelForm();render();toast('บันทึกออเดอร์แล้ว · '+status)};

let liveMaps=[],mapSequence=0,roadBusy=false,roadFailures=new Map(),roadData={};try{roadData=JSON.parse(localStorage.getItem('lunchflow-roads-v1'))||{}}catch{}const straightMetrics=routeMetrics;
function roadKey(ids){return [shop,...ids.map(id=>customer(state.orders.find(o=>o.id===id)?.customer))].filter(Boolean).map(c=>`${c.lng.toFixed(6)},${c.lat.toFixed(6)}`).join(';')}
routeMetrics=function(ids){const cache=roadData[roadKey(ids)];if(!cache||cache.legs.length!==ids.length)return {...straightMetrics(ids),source:'estimate'};let distance=0;const deliveries=ids.map((id,i)=>{distance+=cache.legs[i]/1000;return {id,d:distance,minutes:distance/30*60+(i+1)*state.settings.delay}});return {distance,deliveries,time:distance/30*60+ids.length*state.settings.delay,source:'road'}};
function roadSummary(){let ready=state.routes.filter(r=>routeMetrics(r.ids).source==='road').length;return `${ready}/${state.routes.length} ใบงานใช้ระยะทางถนนจริง · ที่เหลือเป็นค่าประมาณเส้นตรง`}
map=function(only=null){const id='live-map-'+(++mapSequence),routes=only===null?state.routes:state.routes.filter(r=>r.rider===only);return `<div class="map-frame"><div class="map-tools"><span>◉ OpenStreetMap · มหาสารคาม</span><div><button class="secondary small" onclick="retryRoads()">↻ ถนนจริง</button> <button class="secondary small" onclick="focusMap('${id}')">⌖ รวมทุกจุด</button> <button class="secondary small" onclick="expandMap('${id}')">⤢ ขยายแผนที่</button></div></div><div class="map leaflet-map" id="${id}" data-map-rider="${only===null?'all':only}" aria-label="แผนที่จริงและจุดส่งอาหาร"><div class="map-no-service">กำลังเปิดแผนที่จริง…</div></div><div class="map-filter">${routes.map(r=>`<button onclick="focusMap('${id}',${r.rider})"><i class="dot" style="background:${colors[r.rider%8]}"></i>${esc(state.riders[r.rider].name)} · ${r.ids.length} จุด</button>`).join('')}</div><div class="map-status" id="${id}-status">แผนที่จริง · ลูกค้าและร้านเป็นพิกัดตัวอย่าง · เส้นประ = ระยะเส้นตรงที่ยังไม่ยืนยัน</div></div>`};
function clearMaps(){liveMaps.forEach(x=>x.map.remove());liveMaps=[]}
function mapPin(label,color,shopPin=false){return L.divIcon({className:'stop-pin'+(shopPin?' shop-pin':''),html:`<span style="background:${color}">${label}</span>`,iconSize:shopPin?[34,34]:[28,28],iconAnchor:shopPin?[17,17]:[14,14]})}
function initMaps(){if(!window.L){document.querySelectorAll('.leaflet-map').forEach(el=>el.innerHTML='<div class="map-no-service">ไม่สามารถเปิดแผนที่ได้ <a href="https://www.openstreetmap.org/#map=15/16.246/103.250" target="_blank" rel="noopener">เปิด OpenStreetMap ↗</a></div>');return}document.querySelectorAll('.leaflet-map').forEach(el=>{el.innerHTML='';let filter=el.dataset.mapRider,routes=filter==='all'?state.routes:state.routes.filter(r=>r.rider===+filter),points=[[shop.lat,shop.lng]],boundsByRider={};const m=L.map(el,{scrollWheelZoom:false}).setView([shop.lat,shop.lng],14);const tiles=L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',referrerPolicy:'strict-origin-when-cross-origin'}).addTo(m);let loaded=0;tiles.on('tileload',()=>loaded++);tiles.on('tileerror',()=>{if(!loaded){const label=document.getElementById(el.id+'-status');if(label){label.textContent='โหลดแผนที่ไม่สำเร็จ ตรวจสอบอินเทอร์เน็ต หรือเปิด OpenStreetMap โดยตรง';label.classList.add('error')}}});L.control.scale({imperial:false}).addTo(m);L.marker([shop.lat,shop.lng],{icon:mapPin('⌂','#27382c',true)}).addTo(m).bindPopup('<strong>จุดรับอาหารที่ร้าน</strong><div class="sub">พิกัดเริ่มต้นตัวอย่าง แก้ไขได้ในหน้าจัดเส้นทาง</div>');routes.forEach(r=>{const coords=[[shop.lat,shop.lng]],cache=roadData[roadKey(r.ids)];r.ids.forEach((id,i)=>{const o=state.orders.find(o=>o.id===id),c=customer(o.customer),p=[c.lat,c.lng];coords.push(p);points.push(p);L.marker(p,{icon:mapPin(i+1,colors[r.rider%8])}).addTo(m).bindPopup(`<strong>${i+1}. ${esc(c.name)}</strong><div class="sub">${esc(c.address)}<br>${o.boxes} กล่อง · ${esc(state.riders[r.rider].name)}<br>${esc(o.status)}</div><button class="small" onclick="selected=${r.rider};selectedOrder=${o.id};go('delivery')">ดูรายละเอียด →</button>`)});const path=cache?cache.geometry.coordinates.map(c=>[c[1],c[0]]):coords;boundsByRider[r.rider]=path;L.polyline(path,{color:colors[r.rider%8],weight:4,opacity:.85,dashArray:cache?null:'7 9'}).addTo(m).bindTooltip(esc(state.riders[r.rider].name)+(cache?' · เส้นทางถนนจริง':' · เส้นตรงประมาณการ'));path.forEach(p=>points.push(p))});if(!routes.length){state.customers.forEach(c=>{let p=[c.lat,c.lng];points.push(p);L.circleMarker(p,{radius:6,color:'#fff',weight:2,fillColor:'#ef9550',fillOpacity:1}).addTo(m).bindPopup(`<strong>${esc(c.name)}</strong><div class="sub">${esc(c.address)}</div><a href="https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lng}" target="_blank" rel="noopener">ดูตำแหน่ง ↗</a>`)})}m.fitBounds(L.latLngBounds(points).pad(.12),{maxZoom:15});liveMaps.push({id:el.id,map:m,points,boundsByRider});m.invalidateSize();const label=document.getElementById(el.id+'-status');if(label)label.textContent=(routes.length?roadSummary():'ตำแหน่งลูกค้าบนแผนที่จริง')+' · พิกัดตัวอย่าง · เวลาใช้ความเร็ว 30 กม./ชม.'})}
function focusMap(id,rider=null){const entry=liveMaps.find(x=>x.id===id);if(!entry)return;const points=rider===null?entry.points:entry.boundsByRider[rider];if(points?.length)entry.map.fitBounds(L.latLngBounds(points).pad(.15),{maxZoom:16,animate:!window.matchMedia('(prefers-reduced-motion: reduce)').matches})}
function expandMap(id){const el=document.getElementById(id),entry=liveMaps.find(x=>x.id===id);el?.closest('.map-frame').classList.toggle('is-expanded');setTimeout(()=>entry?.map.invalidateSize(),100)}
function retryRoads(){if(roadBusy){toast('กำลังโหลดเส้นทางถนน กรุณารอสักครู่');return}roadFailures.clear();loadRoadRoutes();toast('กำลังตรวจสอบเส้นทางถนน')}
async function loadRoadRoutes(){if(roadBusy)return;const missing=state.routes.filter(r=>!roadData[roadKey(r.ids)]&&Date.now()-(roadFailures.get(roadKey(r.ids))||0)>60000);if(!missing.length)return;roadBusy=true;let updated=false;for(const r of missing){const key=roadKey(r.ids),abort=new AbortController(),timer=setTimeout(()=>abort.abort(),12000);try{const response=await fetch(`https://router.project-osrm.org/route/v1/driving/${key}?overview=full&geometries=geojson&steps=false`,{signal:abort.signal});if(!response.ok)throw Error('HTTP');const data=await response.json(),route=data.routes?.[0];if(data.code!=='Ok'||!route?.geometry?.coordinates?.length||route.legs?.length!==r.ids.length||route.legs.some(l=>!Number.isFinite(l.distance)||l.distance<0))throw Error('No route');roadData[key]={geometry:route.geometry,legs:route.legs.map(l=>l.distance),at:Date.now()};updated=true}catch{roadFailures.set(key,Date.now())}finally{clearTimeout(timer)}}if(updated){let entries=Object.entries(roadData).sort((a,b)=>b[1].at-a[1].at).slice(0,100);roadData=Object.fromEntries(entries);try{localStorage.setItem('lunchflow-roads-v1',JSON.stringify(roadData))}catch{}}roadBusy=false;if(document.querySelector('#modal')?.open)return;if(['dashboard','routes','reports','navigation','jobs'].includes(page))render()}
function deliveryProgress(){const orders=activeOrders(),done=orders.filter(o=>o.status==='ส่งสำเร็จ').length,failed=orders.filter(o=>o.status==='ส่งไม่สำเร็จ').length,pct=orders.length?Math.round(done/orders.length*100):0;return `<section class="live-progress"><div><h3>ติดตามรอบส่งวันนี้</h3><div class="sub">ส่งสำเร็จ ${done} · กำลังส่ง ${orders.filter(o=>o.status==='กำลังจัดส่ง').length} · ต้องติดตาม ${failed}</div></div><div class="delivery-meter"><div class="meter-label"><span>ความคืบหน้าการส่ง</span><strong>${pct}%</strong></div><div class="progress"><span style="width:${pct}%"></span></div></div><button class="secondary" onclick="go('orders')">ดูออเดอร์ →</button></section>`}
const mapRender=render;
render=function(){if(typeof document.querySelectorAll!=='function'){mapRender();return}clearMaps();mapRender();document.body.classList.add('modern-motion');const app=document.querySelector('#app');if(page==='dashboard'){let stats=app.querySelector('.stats');stats?.insertAdjacentHTML('afterend',deliveryProgress());const targets=['orders','routes','reports','reports'];app.querySelectorAll('.stats .card').forEach((el,i)=>{el.tabIndex=0;el.setAttribute('role','button');el.setAttribute('aria-label','เปิด'+el.querySelector('.stat-top').textContent.trim());el.onclick=()=>go(targets[i]);el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go(targets[i])}}})}initMaps();loadRoadRoutes()};
const originalCustomerForm=customerForm;
customerForm=function(id){originalCustomerForm(id);const form=document.querySelector('#modal form');if(!form)return;form.querySelector('.actions').insertAdjacentHTML('beforebegin',`<div class="picker-actions"><button class="secondary small" type="button" onclick="openCoordinatePicker()">⌖ เลือกพิกัดจากแผนที่จริง</button><span class="sub">แตะตำแหน่งบ้านเพื่อใส่พิกัด</span></div><div id="coordinate-picker" class="picker-map" hidden></div><div class="picker-help">พิกัดต้องอยู่ภายใน 3 กม. จากจุดรับอาหารที่ตั้งไว้</div>`)};
let coordinateMap=null;
function openCoordinatePicker(){if(!window.L){toast('ไม่สามารถเปิดแผนที่ได้ ตรวจสอบอินเทอร์เน็ต');return}const el=document.getElementById('coordinate-picker'),form=document.querySelector('#modal form');if(!el||!form)return;el.hidden=false;if(coordinateMap){coordinateMap.remove();coordinateMap=null}let lat=+form.elements.lat.value,lng=+form.elements.lng.value;coordinateMap=L.map(el).setView([lat,lng],16);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>',referrerPolicy:'strict-origin-when-cross-origin'}).addTo(coordinateMap);let marker=L.circleMarker([lat,lng],{radius:8,color:'#2563eb',fillOpacity:.8}).addTo(coordinateMap);L.circle([shop.lat,shop.lng],{radius:3000,color:'#639154',fillOpacity:.03,weight:1}).addTo(coordinateMap);coordinateMap.on('click',e=>{form.elements.lat.value=e.latlng.lat.toFixed(6);form.elements.lng.value=e.latlng.lng.toFixed(6);marker.setLatLng(e.latlng)});setTimeout(()=>coordinateMap?.invalidateSize(),100)}
const originalCancelForm=cancelForm;
cancelForm=function(){coordinateMap?.remove();coordinateMap=null;originalCancelForm()};
function setShop(){showForm(`<h2>จุดรับอาหารที่ร้าน</h2><form onsubmit="saveShop(event)"><p class="sub">ใช้พิกัดจริงของร้านเป็นจุดเริ่มต้นทุกใบงาน</p><div class="two"><div><label>ละติจูด</label><input name="lat" type="number" min="-90" max="90" step="any" required value="${shop.lat}"></div><div><label>ลองจิจูด</label><input name="lng" type="number" min="-180" max="180" step="any" required value="${shop.lng}"></div></div><div class="form-note">หากมีงานที่เริ่มส่งแล้ว ต้องจัดการใบงานนั้นให้เสร็จก่อนเปลี่ยนจุดรับอาหาร</div><div class="actions"><button type="button" class="secondary" onclick="cancelForm()">ปิด</button><button>บันทึกจุดรับอาหาร</button></div></form>`)}
function saveShop(e){e.preventDefault();if(state.routes.some(r=>r.ids.some(id=>['กำลังจัดส่ง','ส่งสำเร็จ','ส่งไม่สำเร็จ'].includes(state.orders.find(o=>o.id===id)?.status)))){toast('ยังมีใบงานที่เริ่มดำเนินการแล้ว ไม่สามารถเปลี่ยนจุดเริ่มต้นได้');return}const data=new FormData(e.target),lat=+data.get('lat'),lng=+data.get('lng');if(!Number.isFinite(lat)||!Number.isFinite(lng)||Math.abs(lat)>90||Math.abs(lng)>180)return;if(state.customers.some(c=>km({lat,lng},c)>3)){toast('จุดรับอาหารใหม่ทำให้ลูกค้าบางรายอยู่นอกรัศมี 3 กม.');return}shop.lat=lat;shop.lng=lng;state.settings.shop={lat,lng};invalidate();save();cancelForm();render();toast('บันทึกจุดรับอาหารแล้ว กรุณาคำนวณเส้นทางใหม่')}
if(state.settings.shop){shop.lat=state.settings.shop.lat;shop.lng=state.settings.shop.lng}
if(typeof document.addEventListener==='function'){document.addEventListener('pointerdown',e=>{const button=e.target.closest('button');if(!button||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;const rect=button.getBoundingClientRect(),size=Math.max(rect.width,rect.height),wave=document.createElement('span');wave.className='ripple-wave';wave.style.cssText=`width:${size}px;height:${size}px;left:${e.clientX-rect.left-size/2}px;top:${e.clientY-rect.top-size/2}px`;button.appendChild(wave);setTimeout(()=>wave.remove(),550)});document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelectorAll('.map-frame.is-expanded').forEach(el=>el.classList.remove('is-expanded'));liveMaps.forEach(x=>x.map.invalidateSize())}})}

window.addEventListener('hashchange',()=>{let p=location.hash.slice(1);if(menus.some(m=>m[0]===p)&&p!==page){page=p;render()}});page=menus.some(m=>m[0]===location.hash.slice(1))?location.hash.slice(1):'dashboard';if(!state.routes.length&&!state.history.length){calculate()}else render();
</script></body></html>
